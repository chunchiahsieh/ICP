<div class="modal fade" id="crudConfirmModal" tabindex="-1" aria-labelledby="crudConfirmModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="crudConfirmModalLabel">@Localizer["Common.Confirm"]</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <p id="crudConfirmMessage"></p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">@Localizer["Common.Cancel"]</button>
                <button type="button" class="btn btn-danger btn-sm" id="crudConfirmOk">@Localizer["Common.Confirm"]</button>
            </div>
        </div>
    </div>
</div>
