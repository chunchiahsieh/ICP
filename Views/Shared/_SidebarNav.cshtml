@if (ShowMenuCategory("Views.Shared._SidebarNav.Systems"))
{
    <div class="sb-sidenav-menu-heading" data-permissions="Views.Shared._SidebarNav.Systems" data-i18n-key="Views.Shared._SidebarNav.Systems">@Localizer["Views.Shared._SidebarNav.Systems"]</div>
    @if (HasMenu("Views.Shared._SidebarNav.Systems.Permissions"))
    {
        <a class="nav-link collapsed" href="#" data-bs-toggle="collapse" data-bs-target="#collapsePermission" aria-expanded="false" aria-controls="collapsePermission" data-permissions="Views.Shared._SidebarNav.Systems.Permissions" data-i18n-key="Views.Shared._SidebarNav.Systems.Permissions">
            @Localizer["Views.Shared._SidebarNav.Systems.Permissions"]
            <div class="sb-sidenav-collapse-arrow"><i class="fas fa-angle-down"></i></div>
        </a>
        <div class="collapse" id="collapsePermission" aria-labelledby="headingPermission" data-bs-parent="#sidenavAccordion">
            <nav class="sb-sidenav-menu-nested nav">
                @if (HasMenu("Views.Shared._SidebarNav.Systems.Permissions.Users"))
                {
                    <a class="nav-link" asp-controller="Users" asp-action="Index" data-permissions="Views.Shared._SidebarNav.Systems.Permissions.Users" data-i18n-key="Views.Shared._SidebarNav.Systems.Permissions.Users">@Localizer["Views.Shared._SidebarNav.Systems.Permissions.Users"]</a>
                }
                @if (HasMenu("Views.Shared._SidebarNav.Systems.Permissions.Resources"))
                {
                    <a class="nav-link" asp-controller="Resources" asp-action="Index" data-permissions="Views.Shared._SidebarNav.Systems.Permissions.Resources" data-i18n-key="Views.Shared._SidebarNav.Systems.Permissions.Resources">@Localizer["Views.Shared._SidebarNav.Systems.Permissions.Resources"]</a>
                }
                @if (HasMenu("Views.Shared._SidebarNav.Systems.Permissions.Roles"))
                {
                    <a class="nav-link" asp-controller="Roles" asp-action="Index" data-permissions="Views.Shared._SidebarNav.Systems.Permissions.Roles" data-i18n-key="Views.Shared._SidebarNav.Systems.Permissions.Roles">@Localizer["Views.Shared._SidebarNav.Systems.Permissions.Roles"]</a>
                }
                @if (HasMenu("Views.Shared._SidebarNav.Systems.Permissions.RolePermissions"))
                {
                    <a class="nav-link" asp-controller="RolePermissions" asp-action="Index" data-permissions="Views.Shared._SidebarNav.Systems.Permissions.RolePermissions" data-i18n-key="Views.Shared._SidebarNav.Systems.Permissions.RolePermissions">@Localizer["Views.Shared._SidebarNav.Systems.Permissions.RolePermissions"]</a>
                }
                @if (HasMenu("Views.Shared._SidebarNav.Systems.Permissions.RoleTelIds"))
                {
                    <a class="nav-link" asp-controller="RoleTelIds" asp-action="Index" data-permissions="Views.Shared._SidebarNav.Systems.Permissions.RoleTelIds" data-i18n-key="Views.Shared._SidebarNav.Systems.Permissions.RoleTelIds">@Localizer["Views.Shared._SidebarNav.Systems.Permissions.RoleTelIds"]</a>
                }
                @if (HasMenu("Views.Shared._SidebarNav.Systems.Permissions.RoleDepIds"))
                {
                    <a class="nav-link" asp-controller="RoleDepIds" asp-action="Index" data-permissions="Views.Shared._SidebarNav.Systems.Permissions.RoleDepIds" data-i18n-key="Views.Shared._SidebarNav.Systems.Permissions.RoleDepIds">@Localizer["Views.Shared._SidebarNav.Systems.Permissions.RoleDepIds"]</a>
                }
                @if (HasMenu("Views.Shared._SidebarNav.Systems.Permissions.RoleMailGroups"))
                {
