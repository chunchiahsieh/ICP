@inject UserResourcePermissionService UserResourcePerm
@{
    bool ShowMenuCategory(string categoryCode) => UserResourcePerm.HasMenuCategoryPermission(categoryCode);
    bool HasMenu(string resourceCode) => UserResourcePerm.HasMenuPermission(resourceCode);
}

