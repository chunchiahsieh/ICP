@using System.Text.Json

@{

    ViewData["Title"] = Localizer["Forwarder.ForwarderDataUpload.Title"];

    var maxSizeMb = ViewData["MaxSizeMb"] as int? ?? 50;

    var maxSizeHint = string.Format(Localizer["Forwarder.ForwarderDataUpload.MaxSizeHint"].Value, maxSizeMb);

    var lengthMenuAll = Localizer["Forwarder.ForwarderDataUpload.LengthMenuAll"].Value;

    var saveButtonText = Localizer["Forwarder.ForwarderDataUpload.SaveButton"].Value;

    var importResultTitle = Localizer["Forwarder.ForwarderDataUpload.ImportResultTitle"].Value;

    var uploaderButtonText = Localizer["Forwarder.ForwarderDataUpload.UploaderButton"].Value;

    var forwarderTableConfigJson = ViewData["ForwarderTableConfigJson"] as string ?? "{}";

}



@section Styles {

    <link rel="stylesheet" href="~/lib/datatables/css/jquery.dataTables.min.css" asp-append-version="true" />

    <link rel="stylesheet" href="~/lib/datatables/css/dataTables.bootstrap.min.css" asp-append-version="true" />

    <link rel="stylesheet" href="~/Uploader/uploader.css" asp-append-version="true" />

    <link rel="stylesheet" href="~/css/forwarder-data-upload.css" asp-append-version="true" />

    <script src="https://cdn.tailwindcss.com"></script>

    <script>

        tailwind.config = {

            corePlugins: {

                preflight: false,

                collapse: false

            }

        };

    </script>

}



<div class="forwarder-data-upload-page"
     data-permissions="Views.Shared._SidebarNav.Forwarder.ForwarderDataUpload"
     data-i18n-key="Views.Shared._SidebarNav.Forwarder.ForwarderDataUpload">

    <div class="d-flex align-items-center justify-content-between mt-3 mb-3">

        <h4 class="mb-0">@Localizer["Forwarder.ForwarderDataUpload.Title"]</h4>

    </div>

    <p class="text-muted small mb-3">@maxSizeHint</p>

    <div class="d-flex align-items-start gap-2 flex-wrap mb-3">

        <div data-permissions="Views.Forwarder.ForwarderDataUpload.Upload"
             data-i18n-key="Views.Forwarder.ForwarderDataUpload.Upload">
            <div id="forwarderUploader"></div>
        </div>

        <a asp-action="DownloadTemplate"
           asp-controller="ForwarderDataUpload"
           class="btn btn-outline-secondary align-self-center"
           data-permissions="Views.Forwarder.ForwarderDataUpload.Upload"
           data-i18n-key="Forwarder.ForwarderDataUpload.DownloadTemplate">
            @Localizer["Forwarder.ForwarderDataUpload.DownloadTemplate"]
        </a>

        <button type="button"

                id="btnSaveImport"

                class="btn btn-primary align-self-center"

                disabled

                data-permissions="Views.Forwarder.ForwarderDataUpload.Upload"

                data-i18n-key="Views.Forwarder.ForwarderDataUpload.Upload">

            @saveButtonText

        </button>

    </div>



    <div id="importResultSection" class="d-none mt-4">

        <div class="d-flex align-items-center justify-content-between mb-2">

            <h5 class="mb-0" id="importResultTitle">@Localizer["Forwarder.ForwarderDataUpload.ImportResultTitle"]</h5>

        </div>

        <div id="pendingFileSection" class="d-none mb-2">

            <span class="text-muted small me-2">@Localizer["Forwarder.ForwarderDataUpload.PendingFilesLabel"]</span>

            <div id="pendingFileList" class="d-inline-flex flex-wrap gap-1"></div>

        </div>

        <div id="pageMessage" class="alert alert-info py-2 mb-3" role="alert"></div>

        <div class="card forwarder-table-card">
            <div class="card-body p-0 forwarder-table-card-body">
                <div id="DataDiv" class="forwarder-data-div"></div>
            </div>
        </div>

    </div>

</div>



<div class="d-none" aria-hidden="true">

    <span data-permissions="Views.Forwarder.ForwarderDataUpload.View"

          data-i18n-key="Views.Forwarder.ForwarderDataUpload.View">@Localizer["Forwarder.ForwarderDataUpload.Title"]</span>

    <button type="button"

            data-permissions="Views.Forwarder.ForwarderDataUpload.Upload"

            data-i18n-key="Views.Forwarder.ForwarderDataUpload.Upload">Upload</button>

</div>



@section Scripts {

    <script src="~/Uploader/index.js" asp-append-version="true"></script>

    <script src="~/lib/datatables/js/jquery.dataTables.min.js" asp-append-version="true"></script>

    <script src="~/lib/datatables/js/dataTables.bootstrap.min.js" asp-append-version="true"></script>

    <script src="~/js/pro-datatables.js" asp-append-version="true"></script>

    <script>

        $(function () {

            var maxSizeMb = @maxSizeMb;

            var lastFilePath = '';

            var activeFilePath = '';

            var pendingFiles = [];

            var isPreviewMode = true;

            var tableInstance = null;

            var lengthMenuAll = @Html.Raw(JsonSerializer.Serialize(lengthMenuAll));

            var alreadySavedMessage = @Html.Raw(JsonSerializer.Serialize(Localizer["Forwarder.ForwarderDataUpload.AlreadySaved"].Value));
            var importResultTitleText = @Html.Raw(JsonSerializer.Serialize(importResultTitle));
            var pendingFilesRemainingText = @Html.Raw(JsonSerializer.Serialize(Localizer["Forwarder.ForwarderDataUpload.PendingFilesRemaining"].Value));
            var previewMessageTemplate = @Html.Raw(JsonSerializer.Serialize(Localizer["Forwarder.ForwarderDataUpload.PreviewMessage"].Value));
            var removePendingFileTitle = @Html.Raw(JsonSerializer.Serialize(Localizer["Forwarder.ForwarderDataUpload.RemovePendingFile"].Value));
            var duplicateInvoiceConfirmMessage = @Html.Raw(JsonSerializer.Serialize(Localizer["Forwarder.ForwarderDataUpload.DuplicateInvoiceConfirm"].Value));
            var duplicateStatusDbDuplicateLabel = @Html.Raw(JsonSerializer.Serialize(Localizer["Forwarder.ForwarderDataUpload.Duplicate.DbDuplicate"].Value));
            var duplicateStatusInFileMultiLineLabel = @Html.Raw(JsonSerializer.Serialize(Localizer["Forwarder.ForwarderDataUpload.Duplicate.InFileMultiLine"].Value));
            var duplicateStatusNoneLabel = @Html.Raw(JsonSerializer.Serialize(Localizer["Forwarder.ForwarderDataUpload.Duplicate.None"].Value));
            var forwarderTableConfig = @Html.Raw(forwarderTableConfigJson);

            function hasPermission(code) {
                var config = window.IcpPermissions || { superUser: false, allowedCodes: [] };
                if (config.superUser) {
                    return true;
                }

                var normalized = (code || '').toLowerCase();
                return (config.allowedCodes || []).some(function (allowed) {
                    return (allowed || '').toLowerCase() === normalized;
                });
            }

            function normalizeFilePath(path) {
                if (!path) {
                    return '';
                }

                return String(path).replace(/\\/g, '/').trim().toLowerCase();
            }

            function pathEquals(pathA, pathB) {
                return normalizeFilePath(pathA) === normalizeFilePath(pathB);
            }

            function findPendingFile(filePath) {
                var key = normalizeFilePath(filePath);
                return pendingFiles.find(function (item) {
                    return normalizeFilePath(item.filePath) === key;
                });
            }



            function getTotalPreviewCount() {

                return pendingFiles.reduce(function (sum, item) {

                    return sum + (Number(item.previewCount) || 0);

                }, 0);

            }



            function buildSummaryMessage() {

                return previewMessageTemplate.replace('{0}', getTotalPreviewCount());

            }



            function updatePageMessage() {

                $('#pageMessage')

                    .removeClass('alert-success d-none')

                    .addClass('alert-info')

                    .text(buildSummaryMessage());

            }



            function resolveFilePath(response) {

                return response.filePath || response.FilePath || '';

            }



            function resolveFileName(response, filePath) {

                if (response && (response.fileName || response.FileName)) {

                    return response.fileName || response.FileName;

                }

                if (!filePath) {

                    return '';

                }

                var parts = filePath.replace(/\\/g, '/').split('/');

                return parts[parts.length - 1] || filePath;

            }



            function renderPendingFileList() {

                $('#pendingFileSection').addClass('d-none');

                $('#pendingFileList').empty();

            }



            function cancelPendingFileQuietly(filePath) {

                if (!filePath) {

                    return $.Deferred().resolve().promise();

                }



                return $.ajax({

                    url: '@Url.Action("CancelPending", "ForwarderDataUpload")',

                    type: 'POST',

                    data: { filePath: filePath },

                    dataType: 'json'

                });

            }



            function setSinglePendingFile(item, done) {

                var previous = pendingFiles.filter(function (pending) {

                    return !pathEquals(pending.filePath, item.filePath);

                });

                pendingFiles = [item];

                if (previous.length === 0) {

                    if (typeof done === 'function') {

                        done();

                    }

                    return;

                }



                $.when.apply($, previous.map(function (pending) {

                    return cancelPendingFileQuietly(pending.filePath);

                })).always(function () {

                    if (typeof done === 'function') {

                        done();

                    }

                });

            }



            function resetImportSection() {

                pendingFiles = [];

                activeFilePath = '';

                lastFilePath = '';

                isPreviewMode = true;

                $('#importResultSection').addClass('d-none');

                $('#btnSaveImport').prop('disabled', true);

                $('#pendingFileSection').addClass('d-none');

                $('#pendingFileList').empty();

                $('#pageMessage').addClass('d-none').text('');

                $('#importResultTitle')

                    .removeClass('text-success')

                    .text(importResultTitleText);

                hidePreviewTable();

            }



            function finalizeRemovePendingFile(filePath) {

                var wasActive = pathEquals(activeFilePath, filePath);

                pendingFiles = pendingFiles.filter(function (item) {

                    return !pathEquals(item.filePath, filePath);

                });



                if (pendingFiles.length === 0) {

                    resetImportSection();

                    return;

                }



                if (wasActive) {

                    selectPendingFile(pendingFiles[0].filePath);

                } else {

                    updatePageMessage();

                    renderPendingFileList();

                }

            }



            function removePendingFile(filePath) {

                if (!filePath) {

                    return;

                }



                $.ajax({

                    url: '@Url.Action("CancelPending", "ForwarderDataUpload")',

                    type: 'POST',

                    data: { filePath: filePath },

                    dataType: 'json',

                    success: function (response) {

                        if (response && response.success) {

                            finalizeRemovePendingFile(filePath);

                            return;

                        }



                        alert(response && response.message ? response.message : removePendingFileTitle);

                    },

                    error: function (xhr) {

                        var message = xhr.responseJSON && xhr.responseJSON.message

                            ? xhr.responseJSON.message

                            : removePendingFileTitle;

                        alert(message);

                    }

                });

            }



            function selectPendingFile(filePath) {

                if (!filePath || pendingFiles.length === 0) {

                    resetImportSection();

                    return;

                }

                var selected = findPendingFile(filePath);

                if (!selected) {

                    console.warn('Pending file not found:', filePath);

                    return;

                }



                activeFilePath = selected.filePath;

                lastFilePath = selected.filePath;

                isPreviewMode = true;



                $('#importResultTitle')

                    .removeClass('text-success')

                    .text(importResultTitleText);



                updatePageMessage();



                $('#btnSaveImport').prop('disabled', false);

                renderPendingFileList();

                reloadPreviewTable();

            }



            function syncForwarderStickyHeaderOffset() {

                if (!forwarderTableConfig.stickyHeader) {

                    return;

                }



                $('#DataDiv .forwarder-pro-table').each(function () {

                    var table = this;

                    var $titleRow = $(table).find('thead.forwarder-sticky-header > tr').first();

                    if (!$titleRow.length) {

                        return;

                    }



                    var titleHeight = Math.ceil($titleRow[0].getBoundingClientRect().height);

                    table.style.setProperty('--forwarder-header-row-height', titleHeight + 'px');

                });

            }



            function buildTableConfig() {

                var sortColumn = forwarderTableConfig.initialSortColumn ?? 0;

                var sortDirection = forwarderTableConfig.initialSortDirection || 'asc';

                return ProDataTables.buildConfig({

                    filterFieldMap: forwarderTableConfig.filterFieldMap || {},

                    filterOptionsUrl: '@Url.Action("GetFilterOptions", "ForwarderDataUpload")',

                    queryUrl: '@Url.Action("Query", "ForwarderDataUpload")',

                    autoLoad: true,

                    pageLength: -1,

                    lengthMenu: [[-1], [lengthMenuAll]],

                    initialSort: [[sortColumn, sortDirection]],

                    onDraw: function () {

                        syncForwarderStickyHeaderOffset();

                    },

                    formatFilterOptionLabel: function (column, value) {

                        if (column === 'DuplicateStatus') {

                            if (value === 'DbDuplicate') {

                                return duplicateStatusDbDuplicateLabel;

                            }

                            if (value === 'InFileMultiLine') {

                                return duplicateStatusInFileMultiLineLabel;

                            }

                            if (value === 'None') {

                                return duplicateStatusNoneLabel;

                            }

                        }

                        return value;

                    },

                    extraQueryParams: function () {

                        return {

                            filePath: lastFilePath,

                            preview: isPreviewMode

                        };

                    },

                    filterOptionsExtraParams: function () {

                        return {

                            filePath: lastFilePath,

                            preview: isPreviewMode

                        };

                    }

                });

            }



            function reloadPreviewTable() {

                if (!lastFilePath || pendingFiles.length === 0) {

                    hidePreviewTable();

                    return;

                }



                if (!tableInstance && window.ProDataTables && ProDataTables.initUsers) {

                    tableInstance = ProDataTables.initUsers(buildTableConfig());

                } else if (tableInstance && tableInstance.reload) {

                    tableInstance.reload();

                }

            }



            function hidePreviewTable() {

                var $table = $('#DataDiv').find('#datatable');

                if ($table.length && $.fn.dataTable.isDataTable($table[0])) {

                    $table.DataTable().destroy();

                }

                $('#DataDiv').addClass('d-none').empty();

                tableInstance = null;

            }



            function showImportResult(response) {

                if (!response || !response.success) {

                    return;

                }



                var filePath = resolveFilePath(response);

                if (!filePath) {

                    return;

                }



                var fileName = resolveFileName(response, filePath);

                var pendingItem = {

                    filePath: filePath,

                    fileName: fileName,

                    message: response.message || '',

                    previewCount: response.previewCount || response.PreviewCount || 0,

                    duplicateInvoiceNos: response.duplicateInvoiceNos || response.DuplicateInvoiceNos || []

                };



                setSinglePendingFile(pendingItem, function () {

                    activeFilePath = filePath;

                    lastFilePath = filePath;

                    isPreviewMode = true;

                    $('#importResultTitle')
                        .removeClass('text-success')
                        .text(importResultTitleText);

                    updatePageMessage();

                    $('#importResultSection').removeClass('d-none');

                    $('#btnSaveImport').prop('disabled', false);

                    $('#DataDiv').removeClass('d-none');

                    renderPendingFileList();

                    reloadPreviewTable();

                });

            }



            function showSaveSuccess(response, savedFilePath) {

                pendingFiles = pendingFiles.filter(function (item) {

                    return !pathEquals(item.filePath, savedFilePath);

                });



                if (pendingFiles.length === 0) {

                    $('#importResultTitle')
                    .addClass('text-success')
                    .text(response.message || '');

                    $('#pageMessage').addClass('d-none');

                    $('#btnSaveImport').prop('disabled', true);

                    $('#pendingFileSection').addClass('d-none');

                    hidePreviewTable();

                    lastFilePath = '';

                    activeFilePath = '';

                    return;

                }



                var remainingMessage = pendingFilesRemainingText.replace('{0}', pendingFiles.length);

                $('#importResultTitle')
                    .removeClass('text-success')
                    .text(importResultTitleText);

                $('#pageMessage')
                    .removeClass('alert-success d-none')
                    .addClass('alert-info')
                    .text(buildSummaryMessage() + ' ' + remainingMessage);

                selectPendingFile(pendingFiles[0].filePath);

            }



            function saveImportFile(filePath, confirmOverwrite) {

                if (!filePath) {

                    return;

                }



                var $btn = $('#btnSaveImport');

                $btn.prop('disabled', true);



                $.ajax({

                    url: '@Url.Action("Save", "ForwarderDataUpload")',

                    type: 'POST',

                    data: {

                        filePath: filePath,

                        confirmOverwrite: !!confirmOverwrite

                    },

                    dataType: 'json',

                    success: function (response) {

                        if (response && response.requiresConfirmation) {

                            $btn.prop('disabled', false);

                            var duplicateInvoiceNos = response.duplicateInvoiceNos || response.DuplicateInvoiceNos || [];

                            if (confirm(response && response.message ? response.message : duplicateInvoiceConfirmMessage)) {

                                saveImportFile(filePath, true);

                                return;

                            }



                            removePendingFile(filePath);

                            return;

                        }



                        if (response && response.success) {

                            showSaveSuccess(response, filePath);

                        } else {

                            $btn.prop('disabled', false);

                            alert(response && response.message ? response.message : alreadySavedMessage);

                        }

                    },

                    error: function (xhr) {

                        $btn.prop('disabled', false);

                        var message = xhr.responseJSON && xhr.responseJSON.message

                            ? xhr.responseJSON.message

                            : '儲存失敗';

                        alert(message);

                    }

                });

            }



            $('#btnSaveImport').on('click', function () {

                if (!activeFilePath || $(this).prop('disabled')) {

                    return;

                }



                var savingFilePath = (findPendingFile(activeFilePath) || { filePath: activeFilePath }).filePath;

                saveImportFile(savingFilePath, false);

            });



            if (hasPermission('Views.Forwarder.ForwarderDataUpload.Upload')
                && typeof window.createUploader === 'function') {

                window.createUploader('#forwarderUploader', {

                    title: @Html.Raw(JsonSerializer.Serialize(Localizer["Forwarder.ForwarderDataUpload.UploaderTitle"].Value)),

                    buttonText: @Html.Raw(JsonSerializer.Serialize(uploaderButtonText)),

                    buttonClass: 'btn btn-primary align-self-center d-inline-flex align-items-center gap-2',

                    uploadUrl: '@Url.Action("Upload", "ForwarderDataUpload")',

                    fileTypes: '.xlsx,.xls,.csv',

                    multiple: false,

                    maxSize: maxSizeMb,

                    maxSizeHint: @Html.Raw(JsonSerializer.Serialize(maxSizeHint)),

                    fieldName: 'file',

                    onSuccess: showImportResult

                });

            }

        });

    </script>

}


