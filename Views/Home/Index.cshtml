@{
    ViewData["Title"] = Localizer["Home.Title"];
}

<br />
<h4>@Localizer["Home.Welcome"]</h4>
<p class="text-muted">@Localizer["Home.Subtitle"]</p>

<div class="table-responsive">
    <table class="table table-striped">
        <thead>
            <tr>
                <th>@Localizer["Home.Feature"]</th>
                <th>@Localizer["Home.Description"]</th>
            </tr>
        </thead>
        <tbody>
            <tr>
                <td><a asp-controller="Home" asp-action="Index">@Localizer["Nav.Home"]</a></td>
                <td>@Localizer["Home.HomeDesc"]</td>
            </tr>
            <tr>
                <td><a asp-controller="Home" asp-action="Privacy">@Localizer["Nav.Privacy"]</a></td>
                <td>@Localizer["Home.PrivacyDesc"]</td>
            </tr>
        </tbody>
    </table>
</div>

<p class="small text-muted">@Localizer["Home.SidebarPlaceholder"]</p>
