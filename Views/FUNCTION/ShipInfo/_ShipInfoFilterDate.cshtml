@model (string FilterId, string FieldName)
<div class="shipinfo-filter shipinfo-filter-date column-filter-date"
     id="@Model.FilterId"
     data-column="@Model.FieldName"
     data-filter-type="Date">
    <input type="date"
           class="form-control form-control-sm shipinfo-filter-date-input"
           aria-label="@Model.FieldName" />
    <div class="shipinfo-filter-actions d-flex gap-1 mt-1">
        <button type="button" class="btn btn-primary btn-sm shipinfo-filter-confirm flex-fill">@Localizer["Common.Confirm"]</button>
        <button type="button" class="btn btn-outline-secondary btn-sm shipinfo-filter-reset">@Localizer["Common.Reset"]</button>
    </div>
</div>
