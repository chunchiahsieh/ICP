@model (string FilterId, string FieldName)
<div class="shipinfo-filter shipinfo-filter-date-range column-filter-date-range"
     id="@Model.FilterId"
     data-column="@Model.FieldName"
     data-filter-type="DateRange">
    <div class="d-flex flex-column gap-1">
        <input type="date"
               class="form-control form-control-sm shipinfo-filter-date-from"
               aria-label="@($"{Model.FieldName} from")" />
        <input type="date"
               class="form-control form-control-sm shipinfo-filter-date-to"
               aria-label="@($"{Model.FieldName} to")" />
    </div>
    <div class="shipinfo-filter-actions d-flex gap-1 mt-1">
        <button type="button" class="btn btn-primary btn-sm shipinfo-filter-confirm flex-fill">@Localizer["Common.Confirm"]</button>
        <button type="button" class="btn btn-outline-secondary btn-sm shipinfo-filter-reset">@Localizer["Common.Reset"]</button>
    </div>
</div>
