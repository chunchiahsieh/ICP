@using System.Text.Json
@{
    ViewData["Title"] = Localizer["Function.AddDiSa.Title"];
    var maxSizeMb = ViewData["MaxSizeMb"] as int? ?? 50;
    var maxSizeHint = string.Format(Localizer["Function.AddDiSa.MaxSizeHint"].Value, maxSizeMb);
    var uploaderButtonText = Localizer["Function.AddDiSa.UploaderButton"].Value;
    var saveButtonText = Localizer["Function.AddDiSa.SaveButton"].Value;
}

@section Styles {
    <link rel="stylesheet" href="~/Uploader/uploader.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/upload-page.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/upload-preview-sort.css" asp-append-version="true" />
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            corePlugins: {
                preflight: false,
                collapse: false
            }
        };
    </script>
}

<div data-permissions="Views.Function.AddDiSa.View"
     data-i18n-key="Views.Function.AddDiSa.View">
    <div class="d-flex align-items-center justify-content-between mt-3 mb-3">
        <h4 class="mb-0">@Localizer["Function.AddDiSa.Title"]</h4>
    </div>
    <p class="text-muted small mb-3">@maxSizeHint</p>

    <div class="d-flex align-items-start gap-2 flex-wrap mb-3">
        <div data-permissions="Views.Function.AddDiSa.Upload"
             data-i18n-key="Views.Function.AddDiSa.Upload">
            <div id="addDiSaUploader"></div>
        </div>
        <a asp-action="DownloadTemplate"
           asp-controller="AddDiSa"
           class="btn btn-outline-secondary align-self-center"
           data-permissions="Views.Function.AddDiSa.Upload"
           data-i18n-key="Function.AddDiSa.DownloadTemplate">
            @Localizer["Function.AddDiSa.DownloadTemplate"]
        </a>
        <button type="button"
                id="btnSaveImport"
                class="btn btn-primary align-self-center"
                disabled
                data-permissions="Views.Function.AddDiSa.Upload"
                data-i18n-key="Views.Function.AddDiSa.Upload">
            @saveButtonText
        </button>
    </div>

    <div id="importResultSection" class="d-none mt-4">
        <div class="d-flex align-items-center justify-content-between mb-2">
            <h5 class="mb-0" id="importResultTitle">@Localizer["Function.AddDiSa.ImportResultTitle"]</h5>
        </div>
        <div id="pageMessage" class="alert alert-info py-2 mb-3" role="alert"></div>
        <div class="card upload-page-preview-card">
            <div class="card-body">
                <div id="DataDiv"></div>
            </div>
        </div>
    </div>
</div>

<div class="d-none" aria-hidden="true">
    <button type="button"
            data-permissions="Views.Function.AddDiSa.Upload"
            data-i18n-key="Views.Function.AddDiSa.Upload">Upload</button>
</div>

@section Scripts {
    <script src="~/Uploader/index.js" asp-append-version="true"></script>
    <script src="~/js/upload-preview-sort.js" asp-append-version="true"></script>
    <script>
        $(function () {
            var maxSizeMb = @maxSizeMb;
            var maxSizeHint = @Html.Raw(JsonSerializer.Serialize(maxSizeHint));
            var uploaderButtonClass = 'btn btn-primary align-self-center d-inline-flex align-items-center gap-2';
            var pendingFilePath = '';
            var pleaseUploadFirst = @Html.Raw(JsonSerializer.Serialize(Localizer["Function.AddDiSa.PleaseUploadFirst"].Value));
            var saveFailed = @Html.Raw(JsonSerializer.Serialize(Localizer["Function.AddDiSa.SaveFailed"].Value));
            var importResultTitleText = @Html.Raw(JsonSerializer.Serialize(Localizer["Function.AddDiSa.ImportResultTitle"].Value));
            var cannotSaveMessage = @Html.Raw(JsonSerializer.Serialize(Localizer["Function.AddDiSa.CannotSaveMessage"].Value));

            function hasPermission(code) {
                var config = window.IcpPermissions || { superUser: false, allowedCodes: [] };
                if (config.superUser) {
                    return true;
                }

                var normalized = (code || '').toLowerCase();
                return (config.allowedCodes || []).some(function (allowed) {
                    return (allowed || '').toLowerCase() === normalized;
                });
            }

            function resolveFilePath(response) {
                return response && (response.filePath || response.FilePath) || '';
            }

            function resolveCanSave(response) {
                if (!response) {
                    return false;
                }

                if (typeof response.canSave === 'boolean') {
                    return response.canSave;
                }

                if (typeof response.CanSave === 'boolean') {
                    return response.CanSave;
                }

                return false;
            }

            function cancelPendingQuietly(filePath) {
                if (!filePath) {
                    return $.Deferred().resolve().promise();
                }

                return $.ajax({
                    url: '@Url.Action("CancelPending", "AddDiSa")',
                    type: 'POST',
                    data: { filePath: filePath },
                    dataType: 'json'
                });
            }

            function bindCanUploadFilter() {
                var $preview = $('#DataDiv').find('.adddisa-preview');
                var $filter = $preview.find('.adddisa-can-upload-filter');
                if (!$filter.length) {
                    return;
                }

                $filter.off('change.addDiSaCanUpload').on('change.addDiSaCanUpload', function () {
                    var selected = String($(this).val() || '');
                    $preview.find('tbody tr[data-upload-status]').each(function () {
                        var statuses = String($(this).attr('data-upload-status') || '').split(/\s+/);
                        $(this).toggle(!selected || statuses.indexOf(selected) >= 0);
                    });
                });
            }

            function bindPreviewSort() {
                if (window.UploadPreviewSort && typeof window.UploadPreviewSort.bind === 'function') {
                    window.UploadPreviewSort.bind($('#DataDiv'));
                }
            }

            function loadPreview(filePath, canSave) {
                if (!filePath) {
                    return;
                }

                $.post('@Url.Action("Query", "AddDiSa")', { filePath: filePath })
                    .done(function (html) {
                        $('#DataDiv').html(html);
                        bindCanUploadFilter();
                        bindPreviewSort();
                        var $preview = $('#DataDiv').find('[data-can-save]');
                        if ($preview.length) {
                            var fromPreview = $preview.attr('data-can-save') === 'true';
                            $('#btnSaveImport').prop('disabled', !fromPreview);
                            if (!fromPreview) {
                                $('#pageMessage')
                                    .removeClass('d-none alert-success alert-info')
                                    .addClass('alert-warning')
                                    .text(cannotSaveMessage);
                            }
                        } else {
                            $('#btnSaveImport').prop('disabled', !canSave);
                        }
                    })
                    .fail(function (xhr) {
                        var message = xhr.responseJSON && xhr.responseJSON.message
                            ? xhr.responseJSON.message
                            : (xhr.responseText || saveFailed);
                        $('#DataDiv').html('<div class="alert alert-danger m-0">' + $('<div>').text(message).html() + '</div>');
                        $('#btnSaveImport').prop('disabled', true);
                    });
            }

            function showImportResult(response) {
                if (!response || !response.success) {
                    return;
                }

                var filePath = resolveFilePath(response);
                if (!filePath) {
                    return;
                }

                var canSave = resolveCanSave(response);
                var previousPath = pendingFilePath;

                function activate() {
                    pendingFilePath = filePath;
                    $('#importResultTitle')
                        .removeClass('text-success')
                        .text(importResultTitleText);
                    $('#pageMessage')
                        .removeClass('d-none alert-success')
                        .toggleClass('alert-info', canSave)
                        .toggleClass('alert-warning', !canSave)
                        .text(response.message || (canSave ? '' : cannotSaveMessage));
                    $('#importResultSection').removeClass('d-none');
                    $('#btnSaveImport').prop('disabled', !canSave);
                    loadPreview(filePath, canSave);
                }

                if (previousPath && previousPath !== filePath) {
                    cancelPendingQuietly(previousPath).always(activate);
                } else {
                    activate();
                }
            }

            $('#btnSaveImport').on('click', function () {
                var $btn = $(this);
                if ($btn.prop('disabled')) {
                    return;
                }

                if (!pendingFilePath) {
                    alert(pleaseUploadFirst);
                    return;
                }

                $btn.prop('disabled', true);

                $.ajax({
                    url: '@Url.Action("Save", "AddDiSa")',
                    type: 'POST',
                    data: { filePath: pendingFilePath },
                    dataType: 'json',
                    success: function (response) {
                        if (response && response.success) {
                            pendingFilePath = '';
                            $('#DataDiv').empty();
                            $('#importResultTitle')
                                .removeClass('text-success')
                                .text(importResultTitleText);
                            $('#pageMessage')
                                .removeClass('d-none alert-info alert-warning')
                                .addClass('alert-success')
                                .text(response.message || '');
                            $('#importResultSection').removeClass('d-none');
                            $btn.prop('disabled', true);
                            return;
                        }

                        $btn.prop('disabled', false);
                        alert(response && response.message ? response.message : saveFailed);
                    },
                    error: function (xhr) {
                        $btn.prop('disabled', false);
                        var message = xhr.responseJSON && xhr.responseJSON.message
                            ? xhr.responseJSON.message
                            : saveFailed;
                        alert(message);
                    }
                });
            });

            if (hasPermission('Views.Function.AddDiSa.Upload')
                && typeof window.createUploader === 'function') {
                window.createUploader('#addDiSaUploader', {
                    title: @Html.Raw(JsonSerializer.Serialize(Localizer["Function.AddDiSa.UploaderTitle"].Value)),
                    buttonText: @Html.Raw(JsonSerializer.Serialize(uploaderButtonText)),
                    buttonClass: uploaderButtonClass,
                    uploadUrl: '@Url.Action("Upload", "AddDiSa")',
                    fileTypes: '.xlsx,.xls',
                    multiple: false,
                    maxSize: maxSizeMb,
                    maxSizeHint: maxSizeHint,
                    fieldName: 'file',
                    onSuccess: showImportResult,
                    onRemove: function (filePath) {
                        if (!filePath) {
                            return;
                        }

                        cancelPendingQuietly(filePath).always(function () {
                            if (pendingFilePath === filePath) {
                                pendingFilePath = '';
                                $('#DataDiv').empty();
                                $('#btnSaveImport').prop('disabled', true);
                                $('#pageMessage').addClass('d-none').text('');
                                $('#importResultSection').addClass('d-none');
                                $('#importResultTitle')
                                    .removeClass('text-success')
                                    .text(importResultTitleText);
                            }
                        });
                    }
                });
            }
        });
    </script>
}
