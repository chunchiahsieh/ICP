@using System.Text.Json
@{
    ViewData["Title"] = Localizer["Views.Shared._SidebarNav.Function.MassUpdateNonNcpi"];
    var maxSizeMb = ViewData["MaxSizeMb"] as int? ?? 50;
    var maxSizeHint = string.Format(Localizer["Function.MassUpdateNonNcpi.MaxSizeHint"].Value, maxSizeMb);
    var uploaderButtonText = Localizer["Function.MassUpdateNonNcpi.UploaderButton"].Value;
}

@section Styles {
    <link rel="stylesheet" href="~/Uploader/uploader.css" asp-append-version="true" />
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            corePlugins: {
                preflight: false,
                collapse: false
            }
        };
    </script>
}

<div data-permissions="Views.Shared._SidebarNav.Function.MassUpdateNonNcpi"
     data-i18n-key="Views.Shared._SidebarNav.Function.MassUpdateNonNcpi">
    <div class="d-flex align-items-center justify-content-between mt-3 mb-3">
        <h4 class="mb-0">@Localizer["Views.Shared._SidebarNav.Function.MassUpdateNonNcpi"]</h4>
    </div>
    <p class="text-muted small mb-3">@maxSizeHint</p>

    <div class="d-flex align-items-start gap-2 flex-wrap mb-3">
        <div data-permissions="Views.Function.MassUpdateNonNcpi.Upload"
             data-i18n-key="Views.Function.MassUpdateNonNcpi.Upload">
            <div id="massUpdateNonNcpiUploader"></div>
        </div>
    </div>
</div>

<div class="d-none" aria-hidden="true">
    <button type="button"
            data-permissions="Views.Function.MassUpdateNonNcpi.Upload"
            data-i18n-key="Views.Function.MassUpdateNonNcpi.Upload">Upload</button>
</div>

@section Scripts {
    <script src="~/Uploader/index.js" asp-append-version="true"></script>
    <script>
        $(function () {
            var maxSizeMb = @maxSizeMb;
            var maxSizeHint = @Html.Raw(JsonSerializer.Serialize(maxSizeHint));
            var uploaderButtonClass = 'btn btn-primary align-self-center d-inline-flex align-items-center gap-2';

            function hasPermission(code) {
                var config = window.IcpPermissions || { superUser: false, allowedCodes: [] };
                if (config.superUser) {
                    return true;
                }

                var normalized = (code || '').toLowerCase();
                return (config.allowedCodes || []).some(function (allowed) {
                    return (allowed || '').toLowerCase() === normalized;
                });
            }

            if (hasPermission('Views.Function.MassUpdateNonNcpi.Upload')
                && typeof window.createUploader === 'function') {
                window.createUploader('#massUpdateNonNcpiUploader', {
                    title: @Html.Raw(JsonSerializer.Serialize(Localizer["Function.MassUpdateNonNcpi.UploaderTitle"].Value)),
                    buttonText: @Html.Raw(JsonSerializer.Serialize(uploaderButtonText)),
                    buttonClass: uploaderButtonClass,
                    uploadUrl: '@Url.Action("Upload", "MassUpdateNonNcpi")',
                    fileTypes: '.xlsx,.xls,.csv',
                    multiple: true,
                    maxSize: maxSizeMb,
                    maxSizeHint: maxSizeHint,
                    fieldName: 'file'
                });
            }
        });
    </script>
}
