@{
    ViewData["Title"] = Localizer["Users.Title"];
}

@section Styles {
    <link rel="stylesheet" href="~/lib/datatables/css/jquery.dataTables.min.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/lib/datatables/css/dataTables.bootstrap.min.css" asp-append-version="true" />
}

<div data-permissions="Views.Permission.Users.View" data-i18n-key="Views.Permission.Users.View">
    <div class="d-flex align-items-center justify-content-between mt-3 mb-3">
        <h4 class="mb-0">@Localizer["Users.Title"]</h4>
    </div>
    <div id="DataDiv"></div>
</div>

@section Scripts {
    <script src="~/lib/datatables/js/jquery.dataTables.min.js" asp-append-version="true"></script>
    <script src="~/lib/datatables/js/dataTables.bootstrap.min.js" asp-append-version="true"></script>
    <script src="~/js/pro-datatables.js" asp-append-version="true"></script>
    <script>
        var filterFieldMap = {
            'filter-KeyId': 'KeyIds',
            'filter-DepName': 'DepNames',
            'filter-UserName': 'UserNames',
            'filter-TelId': 'TelIds',
            'filter-EmailAddress': 'EmailAddresses',
            'filter-DisplayName': 'DisplayNames',
            'filter-DepId': 'DepIds',
            'filter-DepName2': 'DepNames2',
            'filter-CreateDate': 'CreateDates'
        };

        $(function () {
            if (window.ProDataTables && ProDataTables.initUsers) {
                ProDataTables.initUsers(ProDataTables.buildConfig({
                    filterFieldMap: filterFieldMap,
                    filterOptionsUrl: '@Url.Action("GetFilterOptions", "Users")',
                    queryUrl: '@Url.Action("Query", "Users")',
                    initialSort: [[0, 'desc']]
                }));
            }
        });
    </script>
}
