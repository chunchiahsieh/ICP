@{
    ViewData["Title"] = Localizer["Users.Title"];
}

@section Styles {
    <link rel="stylesheet" href="~/lib/datatables/css/jquery.dataTables.min.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/lib/datatables/css/dataTables.bootstrap.min.css" asp-append-version="true" />
}

<div data-permissions="Views.Permission.Users.View" data-i18n-key="Views.Permission.Users.View">
    <div class="d-flex align-items-center justify-content-between mt-3 mb-3">
        <h4 class="mb-0">@Localizer["Users.Title"]</h4>
    </div>
    <div id="DataDiv"></div>
</div>

@await Html.PartialAsync("View.PermissionsModal")

@section Scripts {
    <script src="~/lib/datatables/js/jquery.dataTables.min.js" asp-append-version="true"></script>
    <script src="~/lib/datatables/js/dataTables.bootstrap.min.js" asp-append-version="true"></script>
    <script src="~/js/pro-datatables.js" asp-append-version="true"></script>
    <script>
        var filterFieldMap = {
            'filter-KeyId': 'KeyIds',
            'filter-DepName': 'DepNames',
            'filter-UserName': 'UserNames',
            'filter-TelId': 'TelIds',
            'filter-EmailAddress': 'EmailAddresses',
            'filter-DisplayName': 'DisplayNames',
            'filter-DepId': 'DepIds',
            'filter-DepName2': 'DepNames2',
            'filter-CreateDate': 'CreateDates'
        };

        $(function () {
            if (window.ProDataTables && ProDataTables.initUsers) {
                ProDataTables.initUsers(ProDataTables.buildConfig({
                    filterFieldMap: filterFieldMap,
                    filterOptionsUrl: '@Url.Action("GetFilterOptions", "Users")',
                    queryUrl: '@Url.Action("Query", "Users")',
                    initialSort: [[1, 'desc']]
                }));
            }

            var permissionsModalEl = document.getElementById('userPermissionsModal');
            var permissionsModal = permissionsModalEl && window.bootstrap
                ? bootstrap.Modal.getOrCreateInstance(permissionsModalEl)
                : null;

            $(document).on('click', '.btn-user-permissions', function () {
                var keyId = $(this).data('key-id');
                var $json = $('#userPermissionsJson');
                $json.text('Loading...');

                if (permissionsModal) {
                    permissionsModal.show();
                }

                $.get('@Url.Action("GetPermissions", "Users")', { keyId: keyId })
                    .done(function (data) {
                        $json.text(JSON.stringify(data, null, 2));
                    })
                    .fail(function () {
                        $json.text(@Html.Raw(System.Text.Json.JsonSerializer.Serialize(Localizer["Users.PermissionsLoadFailed"].Value)));
                    });
            });

            var copySuccessMessage = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Localizer["Users.CopyPermissionsJsonSuccess"].Value));
            var loadingText = 'Loading...';

            function copyTextToClipboard(text) {
                if (navigator.clipboard && navigator.clipboard.writeText) {
                    return navigator.clipboard.writeText(text);
                }

                return new Promise(function (resolve, reject) {
                    var $temp = $('<textarea>').css({ position: 'fixed', left: '-9999px', top: '0' }).val(text).appendTo('body');
                    $temp[0].select();
                    try {
                        document.execCommand('copy') ? resolve() : reject();
                    } catch (err) {
                        reject(err);
                    } finally {
                        $temp.remove();
                    }
                });
            }

            $(document).on('click', '#btnCopyUserPermissionsJson', function () {
                var text = $('#userPermissionsJson').text();
                if (!text || text === loadingText) {
                    return;
                }

                var $icon = $('#btnCopyUserPermissionsJsonIcon');
                copyTextToClipboard(text)
                    .then(function () {
                        $icon.removeClass('fa-copy').addClass('fa-check text-success');
                        $('#btnCopyUserPermissionsJson').attr('title', copySuccessMessage);
                        setTimeout(function () {
                            $icon.removeClass('fa-check text-success').addClass('fa-copy');
                            $('#btnCopyUserPermissionsJson').attr('title', @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Localizer["Users.CopyPermissionsJson"].Value)));
                        }, 1500);
                    })
                    .catch(function () {
                        alert(@Html.Raw(System.Text.Json.JsonSerializer.Serialize(Localizer["Users.CopyPermissionsJsonFailed"].Value)));
                    });
            });
        });
    </script>
}
