@model ICP.Models.UsersSearchListViewModel
@{
    var filterColumns = new[]
    {
        ("filter-userpick-DepId", "DepId"),
        ("filter-userpick-DepName", "DepName"),
        ("filter-userpick-DisplayName", "DisplayName"),
        ("filter-userpick-UserName", "UserName")
    };
}

<table id="usersPickTable" class="table table-striped table-sm">
    <thead>
        <tr>
            <th class="sorting_disabled">
                <input type="checkbox" class="pick-select-all" title="全選本頁" />
                <div class="small text-muted fw-normal">@Localizer["Common.SelectAllPage"]</div>
            </th>
            <th>DepID</th>
            <th>DepName</th>
            <th>DisplayName</th>
            <th>UserName</th>
        </tr>
        <tr class="users-filter-row">
            <th class="sorting_disabled"></th>
            @foreach (var (filterId, column) in filterColumns)
            {
                <th class="sorting_disabled">
                    @await Html.PartialAsync("_ProDataTablesFilter", (filterId, column))
                </th>
            }
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model.ListData)
        {
            var depId = item.DepId ?? string.Empty;
            var displayName = item.DepName ?? item.DisplayName ?? depId;
            <tr data-id="@depId" data-code="@depId" data-name="@displayName">
                <td><input type="checkbox" class="row-pick-cb" data-id="@depId" /></td>
                <td>@depId</td>
                <td>@item.DepName</td>
                <td>@item.DisplayName</td>
                <td>@item.UserName</td>
            </tr>
        }
    </tbody>
</table>
