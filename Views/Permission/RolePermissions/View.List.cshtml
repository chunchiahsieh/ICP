@model ICP.Models.RolePermissionsSearchListViewModel
@{
    var filterColumns = new[]
    {
        ("filter-result-RoleCode", "RoleCode"),
        ("filter-result-RoleName", "RoleName"),
        ("filter-result-ResourceCode", "ResourceCode"),
        ("filter-result-ResourceName", "ResourceName"),
        ("filter-result-ActionCode", "ActionCode")
    };
}

<table id="datatable" class="table table-striped">
    <thead>
        <tr>
            <th class="sorting_disabled">
                <input type="checkbox" class="list-select-all" title="全選本頁" />
            </th>
            <th>RoleCode</th>
            <th>RoleName</th>
            <th>ResourceCode</th>
            <th>ResourceName</th>
            <th>ActionCode</th>
        </tr>
        <tr class="users-filter-row">
            <th class="sorting_disabled"></th>
            @foreach (var (filterId, column) in filterColumns)
            {
                <th class="sorting_disabled">
                    @await Html.PartialAsync("_ProDataTablesFilter", (filterId, column))
                </th>
            }
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model.ListData)
        {
            <tr data-id="@item.Id">
                <td><input type="checkbox" class="row-list-cb" data-id="@item.Id" /></td>
                <td>@item.Role.RoleCode</td>
                <td>@item.Role.RoleName</td>
                <td>@item.Resource.ResourceCode</td>
                <td>@item.Resource.ResourceName</td>
                <td>@item.ActionCode</td>
            </tr>
        }
    </tbody>
</table>
