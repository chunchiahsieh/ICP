@using System.Text.Json
@{
    ViewData["Title"] = Localizer["RolePermissions.Title"];
}

@section Styles {
    <link rel="stylesheet" href="~/lib/datatables/css/jquery.dataTables.min.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/lib/datatables/css/dataTables.bootstrap.min.css" asp-append-version="true" />
}

<div data-permissions="Views.Permission.RolePermissions.View" data-i18n-key="Views.Permission.RolePermissions.View">
    <div class="d-flex align-items-center justify-content-between mt-3 mb-3">
        <h4 class="mb-0">@Localizer["RolePermissions.Title"]</h4>
        <div class="d-flex gap-2">
            <button type="button"
                    class="btn btn-outline-danger btn-sm"
                    id="btnBatchDelete"
                    data-permissions="Views.Permission.RolePermissions.Delete"
                    data-i18n-key="Views.Permission.RolePermissions.Delete">
                @Localizer["Common.BatchDelete"]
            </button>
            <button type="button"
                    class="btn btn-primary btn-sm"
                    id="btnOpenBatchCreateWizard"
                    data-permissions="Views.Permission.RolePermissions.Create"
                    data-i18n-key="Views.Permission.RolePermissions.Create">
                @Localizer["Common.CreatePermission"]
            </button>
        </div>
    </div>

    <div id="pageMessage" class="alert alert-success py-2 d-none mb-3" role="alert"></div>

    <h6 class="mb-2">@Localizer["RolePermissions.CreatedList"]</h6>
    <div id="ResultDiv"></div>
</div>

@await Html.PartialAsync("View.BatchCreateWizardDrawer")
@await Html.PartialAsync("_CrudConfirmModal")

@section Scripts {
    <script src="~/lib/datatables/js/jquery.dataTables.min.js" asp-append-version="true"></script>
    <script src="~/lib/datatables/js/dataTables.bootstrap.min.js" asp-append-version="true"></script>
    <script src="~/js/pro-datatables.js" asp-append-version="true"></script>
    <script src="~/js/pro-role-permissions.js" asp-append-version="true"></script>
    <script>
        $(function () {
            ProRolePermissions.init({
                wizardDrawerSelector: '#batchCreateWizardDrawer',
                rolesPickDivSelector: '#RolesPickDiv',
                rolesTableSelector: '#rolesPickTable',
                rolesFilterFieldMap: {
                    'filter-rolepick-RoleCode': 'RoleCodes',
                    'filter-rolepick-RoleName': 'RoleNames'
                },
                rolesQueryUrl: '@Url.Action("QueryRoles", "RolePermissions")',
                rolesFilterOptionsUrl: '@Url.Action("GetFilterOptionsRoles", "RolePermissions")',
                resourcesPickDivSelector: '#ResourcesPickDiv',
                resourcesTableSelector: '#resourcesPickTable',
                resourcesFilterFieldMap: {
                    'filter-respick-ResourceCode': 'ResourceCodes',
                    'filter-respick-ResourceName': 'ResourceNames',
                    'filter-respick-ResourceType': 'ResourceTypes',
                    'filter-respick-SystemCode': 'SystemCodes',
                    'filter-respick-ModuleCode': 'ModuleCodes'
                },
                resourcesQueryUrl: '@Url.Action("QueryResources", "RolePermissions")',
                resourcesFilterOptionsUrl: '@Url.Action("GetFilterOptionsResources", "RolePermissions")',
                resultDivSelector: '#ResultDiv',
                resultTableSelector: '#datatable',
                resultFilterFieldMap: {
                    'filter-result-RoleCode': 'RoleCodes',
                    'filter-result-RoleName': 'RoleNames',
                    'filter-result-ResourceCode': 'ResourceCodes',
                    'filter-result-ResourceName': 'ResourceNames',
                    'filter-result-ActionCode': 'ActionCodes'
                },
                resultQueryUrl: '@Url.Action("Query", "RolePermissions")',
                resultFilterOptionsUrl: '@Url.Action("GetFilterOptions", "RolePermissions")',
                batchCreateUrl: '@Url.Action("BatchCreate", "RolePermissions")',
                batchDeleteUrl: '@Url.Action("BatchDelete", "RolePermissions")',
                batchDeleteConfirmMessage: @Html.Raw(JsonSerializer.Serialize(Localizer["RolePermissions.BatchDeleteConfirm"].Value))
            });
        });
    </script>
}
