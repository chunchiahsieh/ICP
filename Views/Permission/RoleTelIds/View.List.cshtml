@model ICP.Models.RoleTelIdsSearchListViewModel
@{
    var filterColumns = new[]
    {
        ("filter-TelId", "TelId"),
        ("filter-RoleCode", "RoleCode"),
        ("filter-RoleName", "RoleName"),
        ("filter-Description", "Description"),
        ("filter-CreateTime", "CreateTime"),
        ("filter-CreateUser", "CreateUser")
    };
}

<table id="datatable" class="table table-striped">
    <thead>
        <tr>
            <th class="sorting_disabled">
                <input type="checkbox" class="list-select-all" title="全選本頁" />
            </th>
            <th>RoleCode</th>
            <th>RoleName</th>
            <th>TELID</th>
            <th>CreateTime</th>
            <th>CreateUser</th>
        </tr>
        <tr class="users-filter-row">
            <th class="sorting_disabled"></th>
            @foreach (var (filterId, column) in filterColumns)
            {
                <th class="sorting_disabled">
                    @await Html.PartialAsync("_ProDataTablesFilter", (filterId, column))
                </th>
            }
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model.ListData)
        {
            <tr data-id="@item.Id">
                <td><input type="checkbox" class="row-list-cb" data-id="@item.Id" /></td>
                <td>@item.Role.RoleCode</td>
                <td>@item.Role.RoleName</td>
                <td>@item.TelId</td>
                <td>@item.CreateTime.ToString("yyyy-MM-dd HH:mm:ss")</td>
                <td>@item.CreateUser</td>
            </tr>
        }
    </tbody>
</table>
