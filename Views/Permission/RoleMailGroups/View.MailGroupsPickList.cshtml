@model ICP.Models.MailGroupsSearchListViewModel
@{
    var filterColumns = new[]
    {
        ("filter-mailgrouppick-Uid", "Uid"),
        ("filter-mailgrouppick-Name", "Name"),
        ("filter-mailgrouppick-Address", "Address")
    };
}

<table id="mailGroupsPickTable" class="table table-striped table-sm">
    <thead>
        <tr>
            <th class="sorting_disabled">
                <input type="checkbox" class="pick-select-all" title="@Localizer["Common.SelectAllPage"]" />
                <div class="small text-muted fw-normal">@Localizer["Common.SelectAllPage"]</div>
            </th>
            <th>@Localizer["RoleMailGroups.Col.Uid"]</th>
            <th>@Localizer["RoleMailGroups.Col.Name"]</th>
            <th>@Localizer["RoleMailGroups.Col.Address"]</th>
        </tr>
        <tr class="users-filter-row">
            <th class="sorting_disabled"></th>
            @foreach (var (filterId, column) in filterColumns)
            {
                <th class="sorting_disabled">
                    @await Html.PartialAsync("_ProDataTablesFilter", (filterId, column))
                </th>
            }
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model.ListData)
        {
            var address = item.Address?.Trim() ?? string.Empty;
            var hasAddress = !string.IsNullOrEmpty(address);
            <tr data-id="@address" data-code="@address" data-name="@(item.Name ?? string.Empty)">
                <td>
                    @if (hasAddress)
                    {
                        <input type="checkbox" class="row-pick-cb" data-id="@address" />
                    }
                </td>
                <td>@item.Uid</td>
                <td>@item.Name</td>
                <td>@item.Address</td>
            </tr>
        }
    </tbody>
</table>
