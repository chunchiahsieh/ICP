@model ICP.Models.ResourcesSearchListViewModel
@{
    var filterColumns = new[]
    {
        ("filter-respick-ResourceCode", "ResourceCode"),
        ("filter-respick-ResourceName", "ResourceName"),
        ("filter-respick-ResourceType", "ResourceType"),
        ("filter-respick-SystemCode", "SystemCode"),
        ("filter-respick-ModuleCode", "ModuleCode")
    };
}

<table id="resourcesPickTable" class="table table-striped table-sm">
    <thead>
        <tr>
            <th class="sorting_disabled">
                <input type="checkbox" class="pick-select-all" title="全選本頁" />
                <div class="small text-muted fw-normal">全選本頁</div>
            </th>
            <th>ResourceCode</th>
            <th>ResourceName</th>
            <th>ResourceType</th>
            <th>SystemCode</th>
            <th>ModuleCode</th>
        </tr>
        <tr class="users-filter-row">
            <th class="sorting_disabled"></th>
            @foreach (var (filterId, column) in filterColumns)
            {
                <th class="sorting_disabled">
                    @await Html.PartialAsync("_ProDataTablesFilter", (filterId, column))
                </th>
            }
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model.ListData)
        {
            <tr data-id="@item.Id" data-code="@item.ResourceCode" data-name="@item.ResourceName">
                <td><input type="checkbox" class="row-pick-cb" data-id="@item.Id" /></td>
                <td>@item.ResourceCode</td>
                <td>@item.ResourceName</td>
                <td>@item.ResourceType</td>
                <td>@item.SystemCode</td>
                <td>@item.ModuleCode</td>
            </tr>
        }
    </tbody>
</table>
