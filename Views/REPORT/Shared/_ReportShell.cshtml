@{
    var permissionCode = ViewData["PermissionCode"] as string ?? string.Empty;
    var titleKey = ViewData["TitleKey"] as string ?? permissionCode;
}

<div class="container-fluid shipinfo-page report-data-page"
     data-permissions="@permissionCode"
     data-i18n-key="@titleKey">
    <div class="d-flex align-items-center justify-content-between mt-3 mb-3 flex-wrap gap-2">
        <h4 class="mb-0">@Localizer[titleKey]</h4>
        <button type="button" class="btn btn-sm btn-outline-success" id="btnReportDownloadExcel">
            <i class="bi bi-file-earmark-excel me-1"></i>@Localizer["Report.DownloadExcel"]
        </button>
    </div>

    <div class="card mb-3 shipinfo-header-card">
        <div class="card-header">@Localizer["Report.HeaderTitle"]</div>
        <div class="card-body p-0 position-relative shipinfo-table-card-body">
            <div id="reportHeaderDataDiv"></div>
        </div>
    </div>

    <div class="card mb-3 shipinfo-detail-card">
        <div class="card-header">@Localizer["Report.DetailTitle"]</div>
        <div class="card-body p-0 position-relative shipinfo-table-card-body">
            <div id="reportDetailDataDiv"></div>
        </div>
    </div>
</div>
