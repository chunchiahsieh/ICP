@model ICP.Models.RolesSearchListViewModel
@{
    var filterColumns = new[]
    {
        ("filter-rolepick-RoleCode", "RoleCode"),
        ("filter-rolepick-RoleName", "RoleName")
    };
}

<table id="rolesPickTable" class="table table-striped table-sm">
    <thead>
        <tr>
            <th class="sorting_disabled">
                <input type="checkbox" class="pick-select-all" title="全選本頁" />
                <div class="small text-muted fw-normal">@Localizer["Common.SelectAllPage"]</div>
            </th>
            <th>RoleCode</th>
            <th>RoleName</th>
        </tr>
        <tr class="users-filter-row">
            <th class="sorting_disabled"></th>
            @foreach (var (filterId, column) in filterColumns)
            {
                <th class="sorting_disabled">
                    @await Html.PartialAsync("_ProDataTablesFilter", (filterId, column))
                </th>
            }
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model.ListData)
        {
            <tr data-id="@item.Id" data-code="@item.RoleCode" data-name="@item.RoleName">
                <td><input type="checkbox" class="row-pick-cb" data-id="@item.Id" /></td>
                <td>@item.RoleCode</td>
                <td>@item.RoleName</td>
            </tr>
        }
    </tbody>
</table>
