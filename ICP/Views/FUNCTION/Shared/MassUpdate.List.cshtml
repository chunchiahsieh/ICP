@model List<ICP.Models.MassUpdate.MassUpdatePreviewRow>

@{
    string Display(string? value) => value ?? Localizer["Function.MassUpdate.ClearValue"].Value;
}

<div class="mass-update-preview"
     data-can-save="@(Model.Count > 0 && Model.All(row => row.CanSave) ? "true" : "false")">
    <div class="upload-page-preview-toolbar">
        <label class="form-label" for="massUpdateStatusFilter">
            @Localizer["Function.MassUpdate.Column.Status"]
        </label>
        <select id="massUpdateStatusFilter" class="form-select form-select-sm mass-update-status-filter">
            <option value="">@Localizer["Function.MassUpdate.StatusFilter.All"]</option>
            <option value="matched">@Localizer["Function.MassUpdate.StatusFilter.Matched"]</option>
            <option value="notfound">@Localizer["Function.MassUpdate.Status.NotFound"]</option>
            <option value="duplicate">@Localizer["Function.MassUpdate.Status.Duplicate"]</option>
        </select>
    </div>
    <div class="upload-page-preview-scroll mass-update-preview">
    <table class="table table-striped table-sm table-bordered align-middle mb-0 upload-preview-sortable">
        <thead class="table-light">
            <tr>
                <th>@Localizer["Function.MassUpdate.Column.Status"]</th>
                <th>@Localizer["Function.MassUpdate.Column.RowNo"]</th>
                <th>Invoice No</th>
                <th>NCDR No. (Excel / DB)</th>
                <th>Owner (Excel / DB)</th>
                <th>End User (Excel / DB)</th>
                <th>Arrival Notice</th>
                <th>SA Date</th>
                <th>Forwarder</th>
                <th>Broker</th>
                <th>ETA</th>
                <th>MAWB</th>
                <th>HAWB</th>
                <th>FLT</th>
                <th>Delivery Date</th>
                <th>MDP Flag</th>
                <th>Reason for Delivery Delay</th>
                <th>Delay Notification Date</th>
            </tr>
        </thead>
        <tbody>
        @{
            var sequence = 0;
        }
        @foreach (var item in Model)
        {
            sequence++;
            var status = item.IsDuplicateInFile
                ? "duplicate"
                : item.IsNotFound ? "notfound" : "matched";
            var rowClass = item.IsDuplicateInFile
                ? "mass-update-row-duplicate"
                : item.IsNotFound ? "mass-update-row-not-found" : string.Empty;
            <tr class="@rowClass" data-status="@status">
                <td data-sort="@status">
                    @if (item.IsDuplicateInFile)
                    {
                        <span class="text-danger fw-semibold">@Localizer["Function.MassUpdate.Status.Duplicate"]</span>
                    }
                    else if (item.IsNotFound)
                    {
                        <span class="text-warning-emphasis fw-semibold">@Localizer["Function.MassUpdate.Status.NotFound"]</span>
                    }
                    else
                    {
                        <span class="text-success fw-semibold">@string.Format(Localizer["Function.MassUpdate.Status.Matched"].Value, item.MatchedHeaderCount)</span>
                    }
                </td>
                <td class="text-center" data-sort="@sequence">@sequence</td>
                <td>@item.Row.InvoiceNo</td>
                <td>@Display(item.Row.NcdrNo) / @Display(item.DbNcdrNo)</td>
                <td>@Display(item.Row.Owner) / @Display(item.DbOwner)</td>
                <td>@Display(item.Row.EndUser) / @Display(item.DbEndUser)</td>
                <td>@Display(item.Row.ArrivalNotice)</td>
                <td>@Display(item.Row.SaDate)</td>
                <td>@Display(item.Row.Forwarder)</td>
                <td>@Display(item.Row.Broker)</td>
                <td>@Display(item.Row.Eta)</td>
                <td>@Display(item.Row.Mawb)</td>
                <td>@Display(item.Row.Hawb)</td>
                <td>@Display(item.Row.Flt)</td>
                <td>@Display(item.Row.DeliveryDate)</td>
                <td>@Display(item.Row.MdpFlag)</td>
                <td>@Display(item.Row.ReasonForDeliveryDelay)</td>
                <td>@Display(item.Row.DelayNotificationDate)</td>
            </tr>
        }
        </tbody>
    </table>
    </div>
</div>
