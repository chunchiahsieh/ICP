@using System.Text.Json

@{
    ViewData["Title"] = Localizer["Views.Function.ShipInfo.View"];
}

@section Styles {
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/lib/datatables/css/jquery.dataTables.min.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/lib/datatables/css/dataTables.bootstrap.min.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/pro-table-filters.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/shipinfo.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/report-data.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Uploader/uploader.css" asp-append-version="true" />
    @* Uploader/index.js uses Tailwind utility classes for its nested upload modal.
       Keep this configuration aligned with Add DI/SA and disable preflight so the
       Ship Info Bootstrap layout is not reset. *@
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            corePlugins: {
                preflight: false,
                collapse: false
            }
        };
    </script>
}

<div class="container-fluid shipinfo-page report-data-page pro-datatables-page report-split-page"
     data-permissions="Views.Function.ShipInfo.View"
    data-i18n-key="Views.Function.ShipInfo.View">
    <div class="d-flex align-items-center justify-content-between mt-3 mb-3 flex-wrap gap-2 report-split-toolbar">
        <h4 class="mb-0">@Localizer["Views.Function.ShipInfo.View"]</h4>
    </div>

    <div class="report-split-panes">
        <section class="report-split-pane">
            <div class="d-flex align-items-center justify-content-between mb-2 flex-wrap gap-2">
                <h6 class="report-pane-title mb-0">@Localizer["ShipInfo.HeaderTitle"]</h6>
                <div class="d-flex flex-wrap gap-2 align-items-center shipinfo-header-toolbar">
                    <button type="button" class="btn btn-sm btn-outline-secondary" id="btnShipInfoHeaderResetFilters">
                        <i class="bi bi-arrow-counterclockwise me-1"></i>@Localizer["Common.ClearAllFilters"]
                    </button>
                    <button type="button" class="btn btn-sm btn-success" id="btnShipInfoDeposit" data-permissions="Views.Function.ShipInfo.Deposit" disabled>
                        <i class="bi bi-box-arrow-up me-1"></i>@Localizer["ShipInfo.Deposit"]
                    </button>
                    <button type="button" class="btn btn-sm btn-success" id="btnShipInfoArur" data-permissions="Views.Function.ShipInfo.ARUR" disabled>
                        <i class="bi bi-plus-circle me-1"></i>@Localizer["ShipInfo.ARUR"]
                    </button>
                </div>
            </div>
            <div id="shipInfoHeaderDataDiv" class="report-split-table"></div>
        </section>
        <section class="report-split-pane">
            <div class="d-flex align-items-center justify-content-between mb-2 flex-wrap gap-2">
                <h6 class="report-pane-title mb-0">@Localizer["ShipInfo.DetailTitle"]</h6>
                <button type="button" class="btn btn-sm btn-outline-secondary" id="btnShipInfoDetailResetFilters">
                    <i class="bi bi-arrow-counterclockwise me-1"></i>@Localizer["Common.ClearAllFilters"]
                </button>
            </div>
            <div id="shipInfoDetailDataDiv" class="report-split-table"></div>
        </section>
    </div>
</div>

<div class="d-none" aria-hidden="true">
    <button type="button" data-permissions="Views.Function.ShipInfo.Edit" data-i18n-key="Views.Function.ShipInfo.Edit">Edit</button>
    <button type="button" data-permissions="Views.Function.ShipInfo.Discard" data-i18n-key="Views.Function.ShipInfo.Discard">Discard</button>
    <button type="button" data-permissions="Views.Function.ShipInfo.Delete" data-i18n-key="Views.Function.ShipInfo.Delete">Delete</button>
</div>


<div class="modal fade" id="shipInfoViewModal" tabindex="-1" aria-labelledby="shipInfoViewModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header shipinfo-view-modal-header">
                <h5 class="modal-title" id="shipInfoViewModalLabel">@Localizer["ShipInfo.View"]</h5>
                <div class="shipinfo-view-modal-actions ms-auto d-flex flex-wrap gap-2">
                    <button type="button" class="btn btn-sm btn-outline-primary" id="btnShipInfoViewEdit" data-permissions="Views.Function.ShipInfo.Edit">
                        <i class="bi bi-pencil-square me-1"></i>@Localizer["ShipInfo.Edit"]
                    </button>
                    <button type="button" class="btn btn-sm btn-outline-warning" id="btnShipInfoViewDiscard" data-permissions="Views.Function.ShipInfo.Discard">
                        <i class="bi bi-trash3 me-1"></i>@Localizer["ShipInfo.Discard"]
                    </button>
                    <button type="button" class="btn btn-sm btn-outline-danger d-none" id="btnShipInfoViewDelete" data-permissions="Views.Function.ShipInfo.Delete">
                        <i class="bi bi-x-circle me-1"></i>@Localizer["ShipInfo.Delete"]
                    </button>
                    <button type="button" class="btn btn-sm btn-primary d-none" id="btnShipInfoViewSave" data-permissions="Views.Function.ShipInfo.Edit">
                        <i class="bi bi-save me-1"></i>@Localizer["ShipInfo.Save"]
                    </button>
                    <button type="button" class="btn btn-sm btn-outline-secondary d-none" id="btnShipInfoViewCancelEdit">
                        @Localizer["ShipInfo.Cancel"]
                    </button>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="@Localizer["ShipInfo.Close"]"></button>
                </div>
            </div>
            <div class="d-none border-bottom px-3 py-2 align-items-center gap-2" id="shipInfoArrivalScheduleToolbar">
                <span class="shipinfo-notification-label"><i class="bi bi-bell me-1" aria-hidden="true"></i>@Localizer["ShipInfo.ArrivalSchedule.Section"]</span>
                <button type="button" class="btn btn-sm btn-warning shipinfo-notification-action" id="btnShipInfoDeliveryDelayPreview" data-permissions="Views.Function.ShipInfo.Edit">
                    <i class="bi bi-clock-history me-1" aria-hidden="true"></i>@Localizer["NotificationMail.DeliveryDelay"]
                </button>
                <button type="button" class="btn btn-sm btn-primary shipinfo-notification-action" id="btnShipInfoArrivalNoticeSchedule" data-permissions="Views.Function.ShipInfo.Edit">
                    <i class="bi bi-envelope-paper me-1" aria-hidden="true"></i>【@Localizer["ShipInfo.ArrivalSchedule.Button"]】
                </button>
                <button type="button" class="btn btn-sm btn-outline-danger shipinfo-notification-action" id="btnShipInfoControlledGoodsNotice" data-permissions="Views.Function.ShipInfo.Edit">
                    <i class="bi bi-shield-exclamation me-1" aria-hidden="true"></i>@Localizer["NotificationMail.ControlledGoodsArrival"]
                </button>
            </div>
            <div class="modal-body position-relative">
                <div class="shipinfo-modal-mask d-none" id="shipInfoViewModalMask" aria-hidden="true">
                    <div class="spinner-border text-primary" role="status">
                        <span class="visually-hidden">@Localizer["ShipInfo.Loading"]</span>
                    </div>
                </div>
                <form id="shipInfoViewForm" class="row g-3" novalidate></form>
                <div id="shipInfoArrivalSchedulePanel" class="d-none">
                    <div class="d-flex align-items-center gap-2 mb-3">
                        <h5 class="mb-0 flex-shrink-0">@Localizer["ShipInfo.ArrivalSchedule.Title"]</h5>
                        <span id="shipInfoArrivalScheduleError" class="text-danger fw-semibold text-start flex-grow-1 d-none" role="alert"></span>
                        <button type="button" class="btn btn-sm btn-primary text-nowrap ms-auto" id="btnShipInfoArrivalScheduleAdd">@Localizer["ShipInfo.ArrivalSchedule.Add"]</button>
                        <button type="button" class="btn btn-sm btn-outline-secondary text-nowrap" id="btnShipInfoArrivalScheduleClose">@Localizer["ShipInfo.ArrivalSchedule.Close"]</button>
                    </div>
                    <div class="table-responsive shipinfo-arrival-schedule-list">
                        <table class="table table-bordered table-striped align-middle">
                            <thead><tr>
                                <th>@Localizer["ShipInfo.ArrivalSchedule.SendAt"]</th>
                                <th>Invoice No</th><th>@Localizer["NotificationMail.MailTo"]</th>
                                <th>@Localizer["ShipInfo.ArrivalSchedule.Status"]</th><th>@Localizer["ShipInfo.Action"]</th>
                            </tr></thead>
                            <tbody id="shipInfoArrivalScheduleRows"></tbody>
                        </table>
                    </div>
                    <div class="mt-3" id="shipInfoArrivalSchedulePreviews"></div>
                </div>
                <div id="shipInfoDeliveryDelayPanel" class="d-none">
                    <div class="d-flex align-items-center gap-2 mb-3">
                        <h5 class="mb-0 flex-shrink-0">@Localizer["ShipInfo.DeliveryDelay.Title"]</h5>
                        <span id="shipInfoDeliveryDelayError" class="text-danger fw-semibold text-start flex-grow-1 d-none" role="alert"></span>
                        <button type="button" class="btn btn-sm btn-outline-secondary text-nowrap ms-auto" id="btnShipInfoDeliveryDelayClose">@Localizer["ShipInfo.DeliveryDelay.Close"]</button>
                    </div>
                    <div class="d-flex align-items-center gap-2 mb-3">
                        <label class="form-label mb-0" for="shipInfoDeliveryDelayDate">@Localizer["ShipInfo.Field.DelayNotificationDate"]</label>
                        <input type="date" class="form-control form-control-sm w-auto" id="shipInfoDeliveryDelayDate" />
                    </div>
                    <div class="table-responsive shipinfo-arrival-schedule-list">
                        <table class="table table-bordered table-striped align-middle">
                            <thead><tr>
                                <th>Invoice No</th><th>HAWB</th><th>W/H</th><th>FLT</th><th>ETA</th>
                                <th>@Localizer["ShipInfo.Field.ReasonForDeliveryDelay"]</th>
                                <th>@Localizer["ShipInfo.Field.DelayNotificationDate"]</th>
                                <th>@Localizer["ShipInfo.ArrivalSchedule.Status"]</th>
                            </tr></thead>
                            <tbody id="shipInfoDeliveryDelayRows"></tbody>
                        </table>
                    </div>
                    <p class="mb-2"><strong>@Localizer["NotificationMail.SendTimes"]:</strong> <span id="shipInfoDeliveryDelaySendTimes"></span></p>
                    <div id="shipInfoDeliveryDelayPreview" class="border rounded p-3 mt-3">
                        <h6>@Localizer["ShipInfo.DeliveryDelay.Preview"]</h6>
                        <p class="text-muted mb-0" id="shipInfoDeliveryDelayEmpty">@Localizer["ShipInfo.DeliveryDelay.Empty"]</p>
                        <div id="shipInfoDeliveryDelayContent" class="d-none">
                            <p class="mb-1"><strong>@Localizer["NotificationMail.MailTo"]:</strong> <span id="shipInfoDeliveryDelayTo"></span></p>
                            <p class="mb-1"><strong>@Localizer["NotificationMail.CcTo"]:</strong> <span id="shipInfoDeliveryDelayCc"></span></p>
                            <p class="mb-2"><strong>@Localizer["NotificationMail.MailTitle"]:</strong> <span id="shipInfoDeliveryDelaySubject"></span></p>
                            <div class="table-responsive" id="shipInfoDeliveryDelayBody"></div>
                        </div>
                    </div>
                </div>
                <div id="shipInfoControlledGoodsPanel" class="d-none">
                    <div class="d-flex align-items-center gap-2 mb-3">
                        <h5 class="mb-0">@Localizer["NotificationMail.ControlledGoodsArrival"]</h5>
                        <button type="button" class="btn btn-sm btn-danger text-nowrap ms-auto" id="btnShipInfoControlledGoodsAdd">@Localizer["ShipInfo.ArrivalSchedule.Add"]</button>
                        <button type="button" class="btn btn-sm btn-outline-secondary text-nowrap" id="btnShipInfoControlledGoodsClose">@Localizer["ShipInfo.ArrivalSchedule.Close"]</button>
                    </div>
                    <div id="shipInfoControlledGoodsError" class="text-danger fw-semibold mb-3 d-none" role="alert"></div>
                    <div class="d-flex align-items-center gap-2 mb-3">
                        <label class="form-label mb-0" for="shipInfoControlledGoodsEta">ETA</label>
                        <input type="date" class="form-control form-control-sm w-auto" id="shipInfoControlledGoodsEta" />
                    </div>
                    <div class="table-responsive shipinfo-arrival-schedule-list">
                        <table class="table table-bordered table-striped align-middle">
                            <thead><tr><th>@Localizer["ShipInfo.ArrivalSchedule.SendAt"]</th><th>Invoice No</th>
                                <th>ETA</th><th>@Localizer["ShipInfo.ArrivalSchedule.Status"]</th>
                                <th>@Localizer["ShipInfo.Action"]</th></tr></thead>
                            <tbody id="shipInfoControlledGoodsRows"></tbody>
                        </table>
                    </div>
                    <div id="shipInfoControlledGoodsPreviews" class="mt-3"></div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="toast-container position-fixed bottom-0 end-0 p-3" id="shipInfoToastContainer"></div>

<div class="modal fade" id="shipInfoDeleteConfirmModal" tabindex="-1" aria-labelledby="shipInfoDeleteConfirmModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="shipInfoDeleteConfirmModalLabel"></h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="@Localizer["ShipInfo.Close"]"></button>
            </div>
            <div class="modal-body"><p class="mb-0" id="shipInfoDeleteConfirmMessage"></p></div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">@Localizer["ShipInfo.Cancel"]</button>
                <button type="button" class="btn btn-danger" id="btnShipInfoConfirmDelete">@Localizer["ShipInfo.Delete"]</button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="shipInfoDiscardModal" tabindex="-1" aria-labelledby="shipInfoDiscardModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="shipInfoDiscardModalLabel">@Localizer["ShipInfo.DiscardConfirmTitle"]</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="@Localizer["ShipInfo.Close"]"></button>
            </div>
            <div class="modal-body">
                <p>@Localizer["ShipInfo.DiscardConfirmMessage"]</p>
                <label for="shipInfoDiscardReason" class="form-label">@Localizer["ShipInfo.DiscardReason"] <span class="text-danger">*</span></label>
                <textarea id="shipInfoDiscardReason" class="form-control" rows="3" maxlength="200" required></textarea>
                <div class="invalid-feedback">@Localizer["ShipInfo.DiscardReasonRequired"]</div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">@Localizer["ShipInfo.Cancel"]</button>
                <button type="button" class="btn btn-danger" id="btnShipInfoConfirmDiscard">@Localizer["ShipInfo.Discard"]</button>
            </div>
        </div>
    </div>
</div>

<div class="offcanvas offcanvas-end shipinfo-case-drawer" tabindex="-1" id="shipInfoCaseDrawer" aria-labelledby="shipInfoCaseDrawerLabel" data-bs-backdrop="static">
    <div class="offcanvas-header border-bottom">
        <h5 class="offcanvas-title" id="shipInfoCaseDrawerLabel">@Localizer["ShipInfo.CaseDrawerDepositTitle"]</h5>
        <button type="button" class="btn-close" id="btnShipInfoCaseDrawerClose" data-bs-dismiss="offcanvas" aria-label="@Localizer["ShipInfo.Cancel"]"></button>
    </div>
    <div class="offcanvas-body d-flex flex-column p-0 position-relative">
        <div class="shipinfo-drawer-mask d-none" id="shipInfoCaseDrawerMask" aria-hidden="true">
            <div class="spinner-border text-primary" role="status">
                <span class="visually-hidden">@Localizer["ShipInfo.Loading"]</span>
            </div>
        </div>
        <section class="shipinfo-case-drawer-header-summary flex-shrink-0 border-bottom p-3" aria-labelledby="shipInfoCaseHeaderSummaryTitle">
            <h6 class="mb-3" id="shipInfoCaseHeaderSummaryTitle">@Localizer["ShipInfo.HeaderInformation"]</h6>
            <div class="text-danger fw-semibold mb-3 d-none" id="shipInfoCaseValidationMessages" role="alert"></div>
            <div id="shipInfoCaseHeaderSummaryWrap"></div>
        </section>
        <section class="shipinfo-case-drawer-detail-section d-flex flex-column flex-grow-1 min-h-0" aria-labelledby="shipInfoCaseDetailTitle">
            <h6 class="flex-shrink-0 border-bottom mb-0 p-3" id="shipInfoCaseDetailTitle">@Localizer["ShipInfo.DetailInformation"]</h6>
            <div class="shipinfo-case-drawer-detail-scroll flex-grow-1 overflow-auto p-3" id="shipInfoCaseDetailTableWrap"></div>
        </section>
        <div class="shipinfo-case-drawer-footer border-top p-3 d-flex gap-2">
            <button type="button" class="btn btn-outline-secondary flex-grow-1" id="btnShipInfoCaseCancel" data-bs-dismiss="offcanvas">@Localizer["ShipInfo.Cancel"]</button>
            <button type="button" class="btn btn-primary flex-grow-1" id="btnShipInfoCaseSubmit">
                <i class="bi bi-check2-circle me-1"></i>@Localizer["ShipInfo.Submit"]
            </button>
        </div>
    </div>
</div>

<div class="modal fade" id="shipInfoCaseSubmitConfirmModal" tabindex="-1" aria-labelledby="shipInfoCaseSubmitConfirmModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="shipInfoCaseSubmitConfirmModalLabel">@Localizer["ShipInfo.DepositConfirmTitle"]</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="@Localizer["ShipInfo.Cancel"]"></button>
            </div>
            <div class="modal-body">
                <p class="mb-0" id="shipInfoCaseSubmitConfirmMessage">@Localizer["ShipInfo.DepositConfirmMessage"]</p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">@Localizer["ShipInfo.Cancel"]</button>
                <button type="button" class="btn btn-primary" id="btnShipInfoConfirmCaseSubmit">
                    <i class="bi bi-check2-circle me-1"></i>@Localizer["ShipInfo.Confirm"]
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        window.ShipInfoPage = {
            urls: {
                pageConfig: '@Url.Action("GetPageConfig", "ShipInfo")',
                lookupOptions: '@Url.Action("GetLookupOptions", "ShipInfo")',
                searchHeaders: '@Url.Action("SearchHeaders", "ShipInfo")',
                queryHeader: '@Url.Action("QueryHeader", "ShipInfo")',
                queryDetail: '@Url.Action("QueryDetail", "ShipInfo")',
                headerFilterOptions: '@Url.Action("GetHeaderFilterOptions", "ShipInfo")',
                detailFilterOptions: '@Url.Action("GetDetailFilterOptions", "ShipInfo")',
                getHeader: '@Url.Action("GetHeader", "ShipInfo")',
                getDetail: '@Url.Action("GetDetail", "ShipInfo")',
                getDetails: '@Url.Action("GetDetails", "ShipInfo")',
                saveHeader: '@Url.Action("SaveHeader", "ShipInfo")',
                saveDetail: '@Url.Action("SaveDetail", "ShipInfo")',
                validateHeader: '@Url.Action("ValidateHeader", "ShipInfo")',
                validateDetail: '@Url.Action("ValidateDetail", "ShipInfo")',
                getCaseDrawerData: '@Url.Action("GetCaseDrawerData", "ShipInfo")',
                createDeposit: '@Url.Action("CreateDeposit", "ShipInfo")',
                createArur: '@Url.Action("CreateArur", "ShipInfo")',
                discardHeader: '@Url.Action("DiscardHeader", "ShipInfo")',
                deleteHeader: '@Url.Action("DeleteHeader", "ShipInfo")',
                deleteDetail: '@Url.Action("DeleteDetail", "ShipInfo")'
                ,arrivalScheduleToday: '@Url.Action("GetTodayArrivalNoticeSchedules", "ShipInfo")'
                ,arrivalScheduleAdd: '@Url.Action("ScheduleArrivalNotice", "ShipInfo")'
                ,arrivalScheduleCancel: '@Url.Action("CancelArrivalNoticeSchedule", "ShipInfo")'
                ,arrivalSchedulePreview: '@Url.Action("GetArrivalNoticeSchedulePreview", "ShipInfo")'
                ,arrivalScheduleQueuedPreview: '@Url.Action("GetArrivalNoticeQueuedPreview", "ShipInfo")'
                ,deliveryDelayPreview: '@Url.Action("GetDeliveryDelayPreview", "ShipInfo")'
                ,controlledGoodsSchedules: '@Url.Action("GetControlledGoodsNoticeSchedules", "ShipInfo")'
                ,controlledGoodsEligibility: '@Url.Action("GetControlledGoodsNoticeEligibility", "ShipInfo")'
                ,controlledGoodsPreview: '@Url.Action("GetControlledGoodsNoticePreview", "ShipInfo")'
                ,controlledGoodsAdd: '@Url.Action("ScheduleControlledGoodsNotice", "ShipInfo")'
                ,controlledGoodsCancel: '@Url.Action("CancelControlledGoodsNoticeSchedule", "ShipInfo")'
                ,getAttachments: '@Url.Action("GetAttachments", "ShipInfo")'
                ,uploadAttachment: '@Url.Action("UploadAttachment", "ShipInfo")'
                ,downloadAttachment: '@Url.Action("DownloadAttachment", "ShipInfo")'
                ,deleteAttachment: '@Url.Action("DeleteAttachment", "ShipInfo")'
            },
            messages: @Html.Raw(JsonSerializer.Serialize(new
            {
                loading = Localizer["ShipInfo.Loading"].Value,
                noData = Localizer["ShipInfo.NoData"].Value,
                blank = Localizer["ShipInfo.Blank"].Value,
                noDetailData = Localizer["ShipInfo.NoDetailData"].Value,
                selectHeaderFirst = Localizer["ShipInfo.SelectHeaderFirst"].Value,
                saveSuccess = Localizer["ShipInfo.SaveSuccess"].Value,
                saveFailed = Localizer["ShipInfo.SaveFailed"].Value,
                validationFailed = Localizer["ShipInfo.ValidationFailed"].Value,
                delayPairRequired = Localizer["ShipInfo.DelayPairRequired"].Value,
                requiredMark = Localizer["ShipInfo.RequiredMark"].Value,
                edit = Localizer["ShipInfo.Edit"].Value,
                deposit = Localizer["ShipInfo.Deposit"].Value,
                arur = Localizer["ShipInfo.ARUR"].Value,
                discard = Localizer["ShipInfo.Discard"].Value,
                discardSuccess = Localizer["ShipInfo.DiscardSuccess"].Value,
                discardFailed = Localizer["ShipInfo.DiscardFailed"].Value,
                discardReasonRequired = Localizer["ShipInfo.DiscardReasonRequired"].Value,
                deleteSuccess = Localizer["ShipInfo.DeleteSuccess"].Value,
                deleteFailed = Localizer["ShipInfo.DeleteFailed"].Value,
                deleteConfirmTitle = Localizer["ShipInfo.DeleteConfirmTitle"].Value,
                deleteConfirmMessage = Localizer["ShipInfo.DeleteConfirmMessage"].Value,
                deleteDetailConfirmTitle = Localizer["ShipInfo.DeleteDetailConfirmTitle"].Value,
                deleteDetailConfirmMessage = Localizer["ShipInfo.DeleteDetailConfirmMessage"].Value,
                deleteLastDetailNotAllowed = Localizer["ShipInfo.DeleteLastDetailNotAllowed"].Value,
                totalCartonsInteger = Localizer["ShipInfo.TotalCartonsInteger"].Value,
                view = Localizer["ShipInfo.View"].Value,
                editMode = Localizer["ShipInfo.EditMode"].Value,
                close = Localizer["ShipInfo.Close"].Value,
                cancel = Localizer["ShipInfo.Cancel"].Value,
                save = Localizer["ShipInfo.Save"].Value,
                headerInformation = Localizer["ShipInfo.HeaderInformation"].Value,
                detailInformation = Localizer["ShipInfo.DetailInformation"].Value,
                drawerHeader = Localizer["ShipInfo.DrawerHeader"].Value,
                drawerDetail = Localizer["ShipInfo.DrawerDetail"].Value,
                drawerTitle = Localizer["ShipInfo.DrawerTitle"].Value,
                qtyLabel = Localizer["ShipInfo.QtyLabel"].Value,
                depositCompleted = Localizer["ShipInfo.DepositCompleted"].Value,
                arurCompleted = Localizer["ShipInfo.ArurCompleted"].Value,
                statusNotAllowed = Localizer["ShipInfo.StatusNotAllowed"].Value,
                confirm = Localizer["ShipInfo.Confirm"].Value,
                submit = Localizer["ShipInfo.Submit"].Value,
                status = Localizer["ShipInfo.Status"].Value,
                createDate = Localizer["ShipInfo.CreateDate"].Value,
                statusProcessing = Localizer["ShipInfo.Status.Processing"].Value,
                statusCancelled = Localizer["ShipInfo.Status.Cancelled"].Value,
                caseDrawerDepositTitle = Localizer["ShipInfo.CaseDrawerDepositTitle"].Value,
                caseDrawerArurTitle = Localizer["ShipInfo.CaseDrawerArurTitle"].Value,
                depositConfirmTitle = Localizer["ShipInfo.DepositConfirmTitle"].Value,
                depositConfirmMessage = Localizer["ShipInfo.DepositConfirmMessage"].Value,
                arurConfirmTitle = Localizer["ShipInfo.ArurConfirmTitle"].Value,
                arurConfirmMessage = Localizer["ShipInfo.ArurConfirmMessage"].Value,
                arurSubjectTooLong = Localizer["ShipInfo.ArurSubjectTooLong"].Value,
                arurWarehouseTooLong = Localizer["ShipInfo.ArurWarehouseTooLong"].Value,
                arurTetPoTooLong = Localizer["ShipInfo.ArurTetPoTooLong"].Value,
                caseCreateSuccess = Localizer["ShipInfo.CaseCreateSuccess"].Value,
                caseCreateFailed = Localizer["ShipInfo.CaseCreateFailed"].Value,
                caseStatusNotInitiated = Localizer["ShipInfo.CaseStatus.NotInitiated"].Value,
                caseStatusInitiated = Localizer["ShipInfo.CaseStatus.Initiated"].Value,
                caseStatusFailed = Localizer["ShipInfo.CaseStatus.Failed"].Value,
                caseStatusProcessing = Localizer["ShipInfo.CaseStatus.Processing"].Value,
                depositCaseStatus = Localizer["ShipInfo.DepositCaseStatus"].Value,
                arurCaseStatus = Localizer["ShipInfo.ArurCaseStatus"].Value
