@{
    ViewData["Title"] = Localizer["Views.Shared._SidebarNav.Function.MassUpdateNonNcpi"];
    var shellData = new ViewDataDictionary(ViewData)
    {
        ["ControllerName"] = "MassUpdateNonNcpi",
        ["PermissionPrefix"] = "Views.Function.MassUpdateNonNcpi.Upload",
        ["UploaderId"] = "massUpdateNonNcpiUploader",
        ["TitleKey"] = "Function.MassUpdateNonNcpi"
    };
}

@section Styles {
    <link rel="stylesheet" href="~/Uploader/uploader.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/upload-page.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/upload-preview-sort.css" asp-append-version="true" />
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            corePlugins: {
                preflight: false,
                collapse: false
            }
        };
    </script>
}

<div data-permissions="Views.Function.MassUpdateNonNcpi.View"
     data-i18n-key="Views.Function.MassUpdateNonNcpi.View">
    @await Html.PartialAsync("~/Views/FUNCTION/Shared/_MassUpdateShell.cshtml", null, shellData)
    <div class="d-none" aria-hidden="true">
        <button type="button"
                data-permissions="Views.Function.MassUpdateNonNcpi.Upload"
                data-i18n-key="Views.Function.MassUpdateNonNcpi.Upload">Upload</button>
    </div>
</div>

@section Scripts {
    <script src="~/Uploader/index.js" asp-append-version="true"></script>
    <script src="~/js/upload-preview-sort.js" asp-append-version="true"></script>
    <script src="~/js/mass-update.js" asp-append-version="true"></script>
}
