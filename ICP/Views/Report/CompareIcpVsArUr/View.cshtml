@using ICP.Services
@using System.Text.Json
@{
    Layout = "_Layout";
    ViewData["Title"] = Localizer["Views.Shared._SidebarNav.Report.CompareIcpVsArUr"];
}
<div data-permissions="Views.Report.CompareIcpVsArUr.View" data-i18n-key="Views.Report.CompareIcpVsArUr.View">
    <h3>@ViewData["Title"]</h3>
    <p class="text-muted">@Localizer["Compare.Description"]</p>
    <form id="comparisonForm" method="post" action="@Url.Action("DownloadExcel")" class="d-flex flex-wrap align-items-end gap-2 mb-3">
        @Html.AntiForgeryToken()
        <label>@Localizer["Compare.RtNo"]<input name="RtNo" class="form-control form-control-sm" /></label>
        <label>@Localizer["Compare.InvoiceNo"]<input name="InvoiceNo" class="form-control form-control-sm" /></label>
        <label>@Localizer["Compare.Result"]
            <select name="Result" class="form-select form-select-sm">
                <option value="">@Localizer["Compare.All"]</option>
                @foreach (var result in new[] { "Equal", "Different", "Missing", "Ambiguous" })
                { <option value="@result">@Localizer["Compare." + result]</option> }
            </select>
        </label>
        <label>@Localizer["Compare.Field"]
            <select name="Field" class="form-select form-select-sm">
                <option value="">@Localizer["Compare.All"]</option>
                @foreach (var field in ArurComparisonService.Fields)
                { <option value="@field">@Localizer[field is "Notes" or "ShipTo" ? "Compare.Field." + field : "ShipInfo.Field." + field]</option> }
            </select>
        </label>
        <button type="button" id="compareQuery" class="btn btn-sm btn-primary">@Localizer["Compare.Search"]</button>
        <button type="submit" class="btn btn-sm btn-outline-success">@Localizer["Compare.Export"]</button>
    </form>
    <div id="compareError" role="alert" class="text-danger" hidden></div>
    <div class="table-responsive" aria-busy="false" id="compareTableContainer">
        <table class="table table-striped table-bordered">
            <thead><tr>
                @foreach (var key in new[] { "Number", "Result", "RtNo", "InvoiceNo", "Field", "IcpValue", "IlcValue" })
                { <th class="text-nowrap">@Localizer["Compare." + key]</th> }
            </tr></thead>
            <tbody id="compareRows"></tbody>
        </table>
    </div>
    <div class="d-flex flex-wrap align-items-center justify-content-between gap-2">
        <span id="compareSummary" aria-live="polite"></span>
        <div class="d-flex align-items-center gap-2">
            <select id="compareSize" class="form-select form-select-sm w-auto" aria-label="@Localizer["ShipInfo.PageSize"]">
                @foreach (var size in new[] { 10, 25, 50, 100 }) { <option>@size</option> }
            </select>
            <button id="comparePrev" class="btn btn-sm btn-outline-secondary" aria-label="@Localizer["DataTables.Paginate.Previous"]">‹</button>
            <select id="comparePage" class="form-select form-select-sm w-auto" aria-label="@Localizer["ShipInfo.PageLabel"]"></select>
            <span id="comparePages"></span>
            <button id="compareNext" class="btn btn-sm btn-outline-secondary" aria-label="@Localizer["DataTables.Paginate.Next"]">›</button>
        </div>
    </div>
</div>
@section Scripts {
    <script src="~/js/arur-comparison.js" asp-append-version="true"></script>
    <script>
        ArurComparison.init(@Html.Raw(JsonSerializer.Serialize(new {
            url = Url.Action("Query"), error = Localizer["Compare.Error"].Value,
            dataSourceError = Localizer["Compare.DataSourceUnavailable"].Value,
            empty = Localizer["Compare.Empty"].Value
        })));
    </script>
}
