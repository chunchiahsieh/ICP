@model ErrorViewModel
@{
    ViewData["Title"] = Localizer["ErrorPage.Title"];
}

<div class="mt-4">
    <h4 class="text-danger mb-3">@Localizer["ErrorPage.Title"]</h4>
    <p class="text-muted">@Localizer["ErrorPage.Message"]</p>
    @if (!string.IsNullOrEmpty(Model.RequestId))
    {
        <p class="text-muted small">
            <strong>Request ID:</strong> <code>@Model.RequestId</code>
        </p>
    }
</div>
