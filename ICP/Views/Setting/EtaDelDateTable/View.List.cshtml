@model ICP.Models.SystemConfigSearchListViewModel
@{
    var filterColumns = new[]
    {
        ("filter-Key1", "Key1"),
        ("filter-Value1", "Value1"),
        ("filter-Value2", "Value2"),
        ("filter-Value3", "Value3"),
        ("filter-Value4", "Value4"),
        ("filter-Value5", "Value5"),
        ("filter-Value6", "Value6")
    };
}

<div class="table-responsive eta-del-date-table-list">
    <table id="datatable" class="table table-striped table-sm">
        <thead>
            <tr>
                <th class="sorting_disabled">
                    <input type="checkbox" class="list-select-all" title="@Localizer["Common.SelectAllPage"]" />
                </th>
                <th class="sorting_disabled">@Localizer["Common.Actions"]</th>
                <th>Key</th>
                <th>Destination Port</th>
                <th>EtaCalendarType</th>
                <th class="eta-del-whcode">WhCode</th>
                <th>FlightNo</th>
                <th>Del Date</th>
                <th>Remark</th>
            </tr>
            <tr class="users-filter-row">
                <th class="sorting_disabled"></th>
                <th class="sorting_disabled"></th>
                @foreach (var (filterId, column) in filterColumns)
                {
                    <th class="sorting_disabled@(column == "Value3" ? " eta-del-whcode" : "")">
                        @await Html.PartialAsync("_ProDataTablesFilter", (filterId, column))
                    </th>
                }
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model.ListData)
            {
                <tr data-id="@item.Id">
                    <td><input type="checkbox" class="row-list-cb" data-id="@item.Id" /></td>
                    <td>
                        <button type="button"
                                class="btn btn-outline-primary btn-sm btn-crud-edit"
                                data-permissions="Views.Setting.EtaDelDateTable.Edit"
                                data-i18n-key="Views.Setting.EtaDelDateTable.Edit">
                            @Localizer["Common.Edit"]
                        </button>
                    </td>
                    <td>@item.Key1</td>
                    <td>@item.Value1</td>
                    <td>@(string.IsNullOrWhiteSpace(item.Value2)
                        ? ""
                        : Model.EtaCalendarTypeDisplayByKey.TryGetValue(item.Value2.Trim(), out var etaCalendarTypeText)
                            ? etaCalendarTypeText
                            : item.Value2)</td>
                    <td class="eta-del-whcode">@((item.Value3 ?? "").Replace(",", ", "))</td>
                    <td>@item.Value4</td>
                    <td>@item.Value5</td>
                    <td>@item.Value6</td>
                </tr>
            }
        </tbody>
    </table>
</div>
