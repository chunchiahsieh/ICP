<div class="modal fade" id="editModal" tabindex="-1" aria-labelledby="editModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="editModalLabel">@Localizer["Common.Edit"]</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <form id="editForm">
                    <input type="hidden" name="Id" />
                    <div class="alert alert-danger crud-form-error d-none" role="alert"></div>
                    <div class="row g-2">
                        <div class="col-md-6">
                            <label class="form-label">Category</label>
                            <input type="text" class="form-control form-control-sm" name="Category" maxlength="50" />
                            <div class="text-danger small crud-field-error" data-field-error="Category"></div>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">FunctionCode</label>
                            <input type="text" class="form-control form-control-sm" name="FunctionCode" maxlength="50" />
                            <div class="text-danger small crud-field-error" data-field-error="FunctionCode"></div>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Key1</label>
                            <input type="text" class="form-control form-control-sm" name="Key1" maxlength="100" />
                            <div class="text-danger small crud-field-error" data-field-error="Key1"></div>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Key2</label>
                            <input type="text" class="form-control form-control-sm" name="Key2" maxlength="100" />
                            <div class="text-danger small crud-field-error" data-field-error="Key2"></div>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Value1</label>
                            <input type="text" class="form-control form-control-sm" name="Value1" maxlength="1000" />
                            <div class="text-danger small crud-field-error" data-field-error="Value1"></div>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Value2</label>
                            <input type="text" class="form-control form-control-sm" name="Value2" maxlength="1000" />
                            <div class="text-danger small crud-field-error" data-field-error="Value2"></div>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Value3</label>
                            <input type="text" class="form-control form-control-sm" name="Value3" maxlength="1000" />
                            <div class="text-danger small crud-field-error" data-field-error="Value3"></div>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Value4</label>
                            <input type="text" class="form-control form-control-sm" name="Value4" maxlength="1000" />
                            <div class="text-danger small crud-field-error" data-field-error="Value4"></div>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Value5</label>
                            <input type="text" class="form-control form-control-sm" name="Value5" maxlength="1000" />
                            <div class="text-danger small crud-field-error" data-field-error="Value5"></div>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Value6</label>
                            <input type="text" class="form-control form-control-sm" name="Value6" maxlength="1000" />
                            <div class="text-danger small crud-field-error" data-field-error="Value6"></div>
                        </div>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">@Localizer["Common.Cancel"]</button>
                <button type="button" class="btn btn-primary btn-sm" id="btnSaveEdit">@Localizer["Common.Save"]</button>
            </div>
        </div>
    </div>
</div>
