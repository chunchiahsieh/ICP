@model ICP.Models.SystemConfigSearchListViewModel
@{
    var filterColumns = new[]
    {
        ("filter-Category", "Category"),
        ("filter-FunctionCode", "FunctionCode"),
        ("filter-Key1", "Key1"),
        ("filter-Key2", "Key2"),
        ("filter-Value1", "Value1"),
        ("filter-Value2", "Value2"),
        ("filter-Value3", "Value3"),
        ("filter-Value4", "Value4"),
        ("filter-Value5", "Value5"),
        ("filter-Value6", "Value6")
    };
}

<table id="datatable" class="table table-striped table-sm">
        <thead>
            <tr>
                <th class="sorting_disabled">
                    <input type="checkbox" class="list-select-all" title="@Localizer["Common.SelectAllPage"]" />
                </th>
                <th class="sorting_disabled">@Localizer["Common.Actions"]</th>
                <th>@Localizer["Setting.Field.Category"]</th>
                <th>@Localizer["Setting.Field.FunctionCode"]</th>
                <th>@Localizer["Setting.Field.Key1"]</th>
                <th>@Localizer["Setting.Field.Key2"]</th>
                <th>@Localizer["Setting.Field.Value1"]</th>
                <th>@Localizer["Setting.Field.Value2"]</th>
                <th>@Localizer["Setting.Field.Value3"]</th>
                <th>@Localizer["Setting.Field.Value4"]</th>
                <th>@Localizer["Setting.Field.Value5"]</th>
                <th>@Localizer["Setting.Field.Value6"]</th>
            </tr>
            <tr class="users-filter-row">
                <th class="sorting_disabled"></th>
                <th class="sorting_disabled"></th>
                @foreach (var (filterId, column) in filterColumns)
                {
                    <th class="sorting_disabled">
                        @await Html.PartialAsync("_ProDataTablesFilter", (filterId, column))
                    </th>
                }
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model.ListData)
            {
                <tr data-id="@item.Id">
                    <td><input type="checkbox" class="row-list-cb" data-id="@item.Id" /></td>
                    <td>
                        <button type="button"
                                class="btn btn-outline-primary btn-sm btn-crud-edit"
                                data-permissions="Views.Setting.Customized.Edit"
                                data-i18n-key="Views.Setting.Customized.Edit">
                            @Localizer["Common.Edit"]
                        </button>
                    </td>
                    <td>@item.Category</td>
                    <td>@item.FunctionCode</td>
                    <td>@item.Key1</td>
                    <td>@item.Key2</td>
                    <td>@item.Value1</td>
                    <td>@item.Value2</td>
                    <td>@item.Value3</td>
                    <td>@item.Value4</td>
                    <td>@item.Value5</td>
                    <td>@item.Value6</td>
                </tr>
            }
        </tbody>
    </table>
