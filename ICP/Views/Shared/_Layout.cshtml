@using System.Globalization
@inject IConfiguration Configuration
@inject ICP.Services.UserAuthService UserAuth
@inject Microsoft.Extensions.Localization.IStringLocalizer<ICP.SharedResource> Localizer
@{
    var brandName = Configuration["App:BrandName"] ?? "ICP";
    var titleSuffix = Configuration["App:TitleSuffix"] ?? "ICP";
    var pageTitle = ViewData["Title"]?.ToString();
    var currentUser = UserAuth.GetSessionUserInfo();
    var displayLabel = currentUser?.DisplayName ?? currentUser?.UserName ?? currentUser?.TelId ?? "Guest";
    var telIdLabel = currentUser?.TelId;
}
<!DOCTYPE html>
<html lang="@CultureInfo.CurrentUICulture.Name">
<head>
    <meta charset="utf-8" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no" />
    <meta name="description" content="" />
    <meta name="author" content="" />
    <title>@(string.IsNullOrEmpty(pageTitle) ? brandName : $"{pageTitle} - {titleSuffix}")</title>
    <link rel="stylesheet" href="~/css/ilc/styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
    <style>
        #EmailSelector {
            position: absolute;
            background-color: white;
            border-style: solid;
        }

        #ShowFileName ul li {
            display: flex;
        }

        .file-del {
            margin-left: 10px;
            cursor: pointer;
        }

        .remark-area {
            white-space: pre-wrap;
        }
    </style>
    @if (TempData["ReturnMsg"] is string returnMsg && !string.IsNullOrEmpty(returnMsg))
    {
        <script type="text/javascript">
            var message = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(returnMsg));
            alert(message);
        </script>
    }
</head>
<body>
    <nav class="sb-topnav navbar navbar-expand navbar-dark bg-dark">

        <a class="navbar-brand ps-3 d-flex align-items-center gap-2" asp-controller="Home" asp-action="Index" data-permissions="Views.Shared._Layout.Home" data-i18n-key="Views.Shared._Layout.Home">
            <img src="~/Files/TEL_tm_rgb.png" alt="TEL Logo" style="height: 28px; width: auto;" />
            <span>@brandName</span>
        </a>
        <button class="btn btn-link btn-sm order-1 order-lg-0 me-4 me-lg-0" id="sidebarToggle" type="button" aria-label="Toggle navigation">
            <i class="fas fa-bars"></i>
        </button>
        <form class="d-none d-md-inline-block form-inline ms-auto me-0 me-md-3 my-2 my-md-0">
            <partial name="_LanguageSwitcher" />
        </form>
        <ul class="navbar-nav ms-auto ms-md-0 me-3 me-lg-4">
            <li class="nav-item dropdown">
                <a class="nav-link dropdown-toggle" id="navbarDropdown" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                    <i class="fas fa-user fa-fw"></i>
                </a>
                <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="navbarDropdown">
                    <li><span class="dropdown-item-text fw-semibold">@displayLabel</span></li>
                    @if (!string.IsNullOrEmpty(telIdLabel))
                    {
                        <li><span class="dropdown-item-text text-muted small">@telIdLabel</span></li>
                    }
                    <li><hr class="dropdown-divider" /></li>
                    <li>
                        <button type="button" class="dropdown-item" data-icp-refresh-permissions="true">
                            @Localizer["Auth.RefreshSessionPermissions"]
                        </button>
                    </li>
                    <li><a class="dropdown-item" asp-controller="Login" asp-action="Logout">@Localizer["Common.Logout"]</a></li>
                </ul>
            </li>
        </ul>
    </nav>
    <div id="layoutSidenav">
        <div id="layoutSidenav_nav">
            <nav class="sb-sidenav accordion sb-sidenav-dark" id="sidenavAccordion">
                <div class="sb-sidenav-menu">
                    <div class="nav">
                        <partial name="_SidebarNav" />
                    </div>
                </div>
                <div class="sb-sidenav-footer">
                    <div class="small">@Localizer["Common.LoggedInAs"]</div>
                    @displayLabel
                </div>
            </nav>
        </div>
        <div id="layoutSidenav_content">
            <main>
                <div class="container-fluid px-4">
                    <div id="icp-page-access-denied" class="alert alert-warning mt-3 d-none" role="alert"></div>
                    @RenderBody()
                </div>
            </main>
            
        </div>
    </div>

    <partial name="_IcpScriptI18n" />
    <script>
        window.IcpRefreshPermissionsUrl = '@Url.Action("RefreshMySessionPermissions", "Users")';
    </script>
    <script src="~/js/icp-permissions.js" asp-append-version="true"></script>
    <script src="~/js/icp-refresh-permissions.js" asp-append-version="true"></script>
    <script src="~/js/icp-i18n.js" asp-append-version="true"></script>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/ilc/all.js" asp-append-version="true"></script>
    <script src="~/js/ilc/scripts.js" asp-append-version="true"></script>
    <script>
        $(document).ready(function () {
            $(window).on('keydown', function (event) {
                if (event.key === 'Enter' || event.keyCode === 13) {
                    if (event.target.nodeName === 'TEXTAREA') {
                        return true;
                    }
                    return false;
                }
            });
        });
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
