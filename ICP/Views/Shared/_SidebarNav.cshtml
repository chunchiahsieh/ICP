@inject UserResourcePermissionService UserResourcePerm
@inject IConfiguration Configuration
@{
    var controller = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
    bool Has(string code) => UserResourcePerm.HasMenuPermission(code);
    bool Category(string code) => UserResourcePerm.HasMenuCategoryPermission(code);
    bool Active(string target) => controller.Equals(target, StringComparison.OrdinalIgnoreCase);
    string LinkClass(string target) => Active(target) ? "nav-link active" : "nav-link";
    string Current(string target) => Active(target) ? "page" : null!;
    var languageEnabled = Configuration.GetValue<bool>("LocalizationManagement:Enabled");
    var recentEnabled = Configuration.GetValue<bool?>("Sidebar:RecentEnabled") ?? true;
    var recentLimit = Math.Clamp(Configuration.GetValue<int?>("Sidebar:RecentLimit") ?? 3, 0, 50);
    var pinnedLimit = Math.Clamp(Configuration.GetValue<int?>("Sidebar:PinnedLimit") ?? 5, 0, 20);
    var customLinks = Configuration.GetSection("Sidebar:CustomLinks").GetChildren()
        .Where(link => link.GetValue<bool?>("Enabled") != false && !string.IsNullOrWhiteSpace(link["Name"]))
        .Where(link =>
        {
            var url = link["Url"]?.Trim();
            return !string.IsNullOrWhiteSpace(url) &&
                ((url.StartsWith('/') && !url.StartsWith("//", StringComparison.Ordinal)) ||
                 (Uri.TryCreate(url, UriKind.Absolute, out var uri) &&
                  (uri.Scheme == Uri.UriSchemeHttp || uri.Scheme == Uri.UriSchemeHttps)));
        })
        .OrderBy(link => link.GetValue<int?>("SortOrder") ?? int.MaxValue)
        .ThenBy(link => link["Name"], StringComparer.CurrentCultureIgnoreCase)
        .ToArray();
}
<div class="sidebar-menu-search"><label class="visually-hidden" for="sidebarMenuSearch">@Localizer["Sidebar.Search"]</label><input id="sidebarMenuSearch" type="search" class="form-control form-control-sm" placeholder="@Localizer["Sidebar.Search"]" autocomplete="off" /></div>
<p id="sidebarSearchCount" class="sidebar-search-count" role="status" aria-live="polite" data-template="@Localizer["Sidebar.SearchCount"]" hidden></p>
<p id="sidebarSearchEmpty" class="sidebar-search-empty" role="status" aria-live="polite" hidden>@Localizer["Sidebar.NoResults"]</p>
<section id="sidebarPinnedGroup" class="sidebar-menu-group" data-sidebar-menu-group data-pinned-limit="@pinnedLimit" data-pin-label="@Localizer["Sidebar.Pin"]" data-unpin-label="@Localizer["Sidebar.Unpin"]" hidden><div class="sb-sidenav-menu-heading">@Localizer["Sidebar.Pinned"]</div><div id="sidebarPinnedLinks"></div></section>
@if (recentEnabled)
{
    <section id="sidebarRecentGroup" class="sidebar-menu-group" data-sidebar-menu-group data-recent-limit="@recentLimit" hidden><div class="sb-sidenav-menu-heading sidebar-recent-heading"><span>@Localizer["Sidebar.Recent"]</span><button id="sidebarClearRecent" type="button" class="sidebar-clear-recent" title="@Localizer["Sidebar.ClearRecent"]" aria-label="@Localizer["Sidebar.ClearRecent"]"><i class="fa-solid fa-trash-can" aria-hidden="true"></i></button></div><div id="sidebarRecentLinks"></div></section>
}
@if (customLinks.Length > 0)
{
    <section class="sidebar-menu-group" data-sidebar-menu-group>
        <div class="sb-sidenav-menu-heading"><button type="button" class="sidebar-group-toggle collapsed" data-bs-toggle="collapse" data-bs-target="#sidebarCustomLinks" aria-expanded="false" aria-controls="sidebarCustomLinks"><span><i class="fa-solid fa-link sidebar-group-icon" aria-hidden="true"></i>@Localizer["Sidebar.CustomLinks"]</span><span class="sidebar-group-count">@customLinks.Length</span><i class="fas fa-angle-down" aria-hidden="true"></i></button></div>
        <div class="collapse" id="sidebarCustomLinks">
            @foreach (var link in customLinks)
            {
                // Configured links use the supplied name and are independent of role permissions and localization.
                var label = link["Name"];
                var opensInNewTab = link.GetValue<bool>("OpenInNewTab");
                var title = opensInNewTab ? $"{label} ({Localizer["Sidebar.OpenInNewTab"]})" : label;
                <a class="nav-link" href="@link["Url"]" target="@(opensInNewTab ? "_blank" : "_self")" rel="noopener noreferrer" title="@title" data-sidebar-search-label="@label">@label@if (opensInNewTab) { <i class="fa-solid fa-arrow-up-right-from-square sidebar-external-icon" aria-hidden="true"></i><span class="visually-hidden"> @Localizer["Sidebar.OpenInNewTab"]</span> }</a>
            }
        </div>
    </section>
}
