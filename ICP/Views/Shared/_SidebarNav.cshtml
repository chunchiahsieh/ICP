@inject UserResourcePermissionService UserResourcePerm
@inject IConfiguration Configuration
@{
    var controller = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
    bool Has(string code) => UserResourcePerm.HasMenuPermission(code);
    bool Category(string code) => UserResourcePerm.HasMenuCategoryPermission(code);
    bool Active(string target) => controller.Equals(target, StringComparison.OrdinalIgnoreCase);
    string LinkClass(string target) => Active(target) ? "nav-link active" : "nav-link";
    string Current(string target) => Active(target) ? "page" : null!;
    string Icon(string group) => group switch { "Functions" => "fa-solid fa-list-check", "Settings" => "fa-solid fa-gear", "Reports" => "fa-solid fa-chart-column", "Forwarder" => "fa-solid fa-truck", "Broker" => "fa-solid fa-file-shield", "Administration" => "fa-solid fa-user-gear", _ => "fa-solid fa-folder" };
    var languageEnabled = Configuration.GetValue<bool>("LocalizationManagement:Enabled");
    var recentEnabled = Configuration.GetValue<bool?>("Sidebar:RecentEnabled") ?? true;
    var recentLimit = Math.Clamp(Configuration.GetValue<int?>("Sidebar:RecentLimit") ?? 3, 0, 50);
    var pinnedLimit = Math.Clamp(Configuration.GetValue<int?>("Sidebar:PinnedLimit") ?? 5, 0, 20);
    var menuOrder = Configuration.GetSection("Sidebar:MenuOrder").Get<Dictionary<string, int>>() ?? new Dictionary<string, int>(StringComparer.OrdinalIgnoreCase);
    int MenuOrder(string target) => menuOrder.TryGetValue(target, out var order) ? order : int.MaxValue;
    var customLinks = Configuration.GetSection("Sidebar:CustomLinks").GetChildren()
        .Where(link => link.GetValue<bool?>("Enabled") != false && !string.IsNullOrWhiteSpace(link["Name"]))
        .Where(link => Uri.TryCreate(link["Url"], UriKind.Absolute, out var uri) &&
            (uri.Scheme == Uri.UriSchemeHttp || uri.Scheme == Uri.UriSchemeHttps))
        .OrderBy(link => link.GetValue<int?>("SortOrder") ?? int.MaxValue)
        .ThenBy(link => link["Name"], StringComparer.CurrentCultureIgnoreCase)
        .ToArray();
    var groups = new[] {
        (Id:"Functions", Key:"Views.Shared._SidebarNav.Function", Items:new[] { ("ShipInfo","Views.Shared._SidebarNav.Function.ShipInfo"),("AddDiSa","Views.Shared._SidebarNav.Function.AddDiSa"),("MassUpdateNonNcpi","Views.Shared._SidebarNav.Function.MassUpdateNonNcpi"),("MassUpdateNcpi","Views.Shared._SidebarNav.Function.MassUpdateNcpi"),("Export","Views.Shared._SidebarNav.Function.Export") }),
        (Id:"Settings", Key:"Views.Shared._SidebarNav.Setting", Items:new[] { ("BuCode","Views.Shared._SidebarNav.Setting.BuCode"),("WhCode","Views.Shared._SidebarNav.Setting.WhCode"),("DeliveryToList","Views.Shared._SidebarNav.Setting.DeliveryToList"),("PickUpLocation","Views.Shared._SidebarNav.Setting.PickUpLocation"),("EtaDelDateTable","Views.Shared._SidebarNav.Setting.EtaDelDateTable"),("DefaultDeliveryWh","Views.Shared._SidebarNav.Setting.DefaultDeliveryWh"),("OrderType","Views.Shared._SidebarNav.Setting.OrderType"),("AirSea","Views.Shared._SidebarNav.Setting.AirSea"),("Broker","Views.Shared._SidebarNav.Setting.Broker"),("InvoiceType","Views.Shared._SidebarNav.Setting.InvoiceType"),("OrderPriority","Views.Shared._SidebarNav.Setting.OrderPriority"),("Customized","Views.Shared._SidebarNav.Setting.Customized") }),
        (Id:"Reports", Key:"Views.Shared._SidebarNav.Report", Items:new[] { ("ShippingReport","Views.Shared._SidebarNav.Report.ShippingReport"),("CompareIcpVsArUr","Views.Shared._SidebarNav.Report.CompareIcpVsArUr"),("MassDataReport","Views.Shared._SidebarNav.Report.MassDataReport") }),
        (Id:"Forwarder", Key:"Views.Shared._SidebarNav.Forwarder", Items:new[] { ("ForwarderDataUpload","Views.Shared._SidebarNav.Forwarder.ForwarderDataUpload") }),
        (Id:"Broker", Key:"Views.Shared._SidebarNav.Broker", Items:new[] { ("CustomsDataDownload","Views.Shared._SidebarNav.Broker.CustomsDataDownload"),("TariffData","Views.Shared._SidebarNav.Broker.TariffData") })
    };
}
<div class="sidebar-menu-search"><label class="visually-hidden" for="sidebarMenuSearch">@Localizer["Sidebar.Search"]</label><input id="sidebarMenuSearch" type="search" class="form-control form-control-sm" placeholder="@Localizer["Sidebar.Search"]" autocomplete="off" /></div>
<p id="sidebarSearchCount" class="sidebar-search-count" role="status" aria-live="polite" data-template="@Localizer["Sidebar.SearchCount"]" hidden></p>
<p id="sidebarSearchEmpty" class="sidebar-search-empty" role="status" aria-live="polite" hidden>@Localizer["Sidebar.NoResults"]</p>
<section id="sidebarPinnedGroup" class="sidebar-menu-group" data-sidebar-menu-group data-pinned-limit="@pinnedLimit" data-pin-label="@Localizer["Sidebar.Pin"]" data-unpin-label="@Localizer["Sidebar.Unpin"]" hidden><div class="sb-sidenav-menu-heading">@Localizer["Sidebar.Pinned"]</div><div id="sidebarPinnedLinks"></div></section>
@if (recentEnabled)
{
    <section id="sidebarRecentGroup" class="sidebar-menu-group" data-sidebar-menu-group data-recent-limit="@recentLimit" hidden><div class="sb-sidenav-menu-heading sidebar-recent-heading"><span>@Localizer["Sidebar.Recent"]</span><button id="sidebarClearRecent" type="button" class="sidebar-clear-recent" title="@Localizer["Sidebar.ClearRecent"]" aria-label="@Localizer["Sidebar.ClearRecent"]"><i class="fa-solid fa-trash-can" aria-hidden="true"></i></button></div><div id="sidebarRecentLinks"></div></section>
}
@if (customLinks.Length > 0)
{
    <section class="sidebar-menu-group" data-sidebar-menu-group>
        <div class="sb-sidenav-menu-heading"><button type="button" class="sidebar-group-toggle collapsed" data-bs-toggle="collapse" data-bs-target="#sidebarCustomLinks" aria-expanded="false" aria-controls="sidebarCustomLinks"><span><i class="fa-solid fa-link sidebar-group-icon" aria-hidden="true"></i>@Localizer["Sidebar.CustomLinks"]</span><span class="sidebar-group-count">@customLinks.Length</span><i class="fas fa-angle-down" aria-hidden="true"></i></button></div>
        <div class="collapse" id="sidebarCustomLinks">
            @foreach (var link in customLinks)
            {
                // Configured links use the supplied name and are independent of role permissions and localization.
                var label = link["Name"];
                var opensInNewTab = link.GetValue<bool>("OpenInNewTab");
                var title = opensInNewTab ? $"{label} ({Localizer["Sidebar.OpenInNewTab"]})" : label;
                <a class="nav-link" href="@link["Url"]" target="@(opensInNewTab ? "_blank" : "_self")" rel="noopener noreferrer" title="@title" data-sidebar-search-label="@label">@label@if (opensInNewTab) { <i class="fa-solid fa-arrow-up-right-from-square sidebar-external-icon" aria-hidden="true"></i><span class="visually-hidden"> @Localizer["Sidebar.OpenInNewTab"]</span> }</a>
            }
        </div>
    </section>
}
@foreach (var group in groups)
{
    var visibleItems = group.Items.Where(item => Has(item.Item2)).OrderBy(item => MenuOrder(item.Item1)).ToArray();
    var expanded = group.Items.Any(item => Active(item.Item1));
    if (Category(group.Key) && visibleItems.Length > 0)
    {
        <section class="sidebar-menu-group" data-sidebar-menu-group>
            <div class="sb-sidenav-menu-heading" data-permissions="@group.Key" data-i18n-key="@group.Key"><button type="button" class="sidebar-group-toggle @(!expanded ? "collapsed" : null)" data-bs-toggle="collapse" data-bs-target="@($"#sidebar{group.Id}")" aria-expanded="@expanded.ToString().ToLowerInvariant()" aria-controls="@($"sidebar{group.Id}")"><span><i class="@Icon(group.Id) sidebar-group-icon" aria-hidden="true"></i>@Localizer[group.Key]</span><span class="sidebar-group-count">@visibleItems.Length</span><i class="fas fa-angle-down" aria-hidden="true"></i></button></div>
            <div class="collapse @(expanded ? "show" : null)" id="@($"sidebar{group.Id}")">
                @foreach (var item in visibleItems) { <a class="@LinkClass(item.Item1)" aria-current="@Current(item.Item1)" asp-controller="@item.Item1" asp-action="Index" title="@Localizer[item.Item2]" data-permissions="@item.Item2" data-i18n-key="@item.Item2">@Localizer[item.Item2]</a> }
            </div>
        </section>
    }
}
@if (languageEnabled)
{
    <section class="sidebar-menu-group" data-sidebar-menu-group><div class="sb-sidenav-menu-heading" data-i18n-key="Views.Shared._SidebarNav.Localization"><i class="fa-solid fa-language sidebar-group-icon" aria-hidden="true"></i>@Localizer["Views.Shared._SidebarNav.Localization"]<span class="sidebar-group-count">1</span></div><a class="@LinkClass("LocalizationManagement")" aria-current="@Current("LocalizationManagement")" asp-controller="LocalizationManagement" asp-action="Index" title="@Localizer["Views.Shared._SidebarNav.Setting.LocalizationManagement"]" data-i18n-key="Views.Shared._SidebarNav.Setting.LocalizationManagement">@Localizer["Views.Shared._SidebarNav.Setting.LocalizationManagement"]</a></section>
}
@{
    var permissionItems = new[] { ("Users","Views.Shared._SidebarNav.Systems.Permissions.Users"),("Resources","Views.Shared._SidebarNav.Systems.Permissions.Resources"),("Roles","Views.Shared._SidebarNav.Systems.Permissions.Roles"),("RolePermissions","Views.Shared._SidebarNav.Systems.Permissions.RolePermissions"),("RoleTelIds","Views.Shared._SidebarNav.Systems.Permissions.RoleTelIds"),("RoleDepIds","Views.Shared._SidebarNav.Systems.Permissions.RoleDepIds"),("RoleMailGroups","Views.Shared._SidebarNav.Systems.Permissions.RoleMailGroups") };
    var visiblePermissionItems = permissionItems.Where(item => Has(item.Item2)).OrderBy(item => MenuOrder(item.Item1)).ToArray();
    var administrationExpanded = permissionItems.Any(item => Active(item.Item1));
}
@if (Category("Views.Shared._SidebarNav.Systems") && Has("Views.Shared._SidebarNav.Systems.Permissions") && visiblePermissionItems.Length > 0)
{
    <section class="sidebar-menu-group" data-sidebar-menu-group><div class="sb-sidenav-menu-heading" data-permissions="Views.Shared._SidebarNav.Systems" data-i18n-key="Views.Shared._SidebarNav.Systems"><button type="button" class="sidebar-group-toggle @(!administrationExpanded ? "collapsed" : null)" data-bs-toggle="collapse" data-bs-target="#sidebarAdministration" aria-expanded="@administrationExpanded.ToString().ToLowerInvariant()" aria-controls="sidebarAdministration"><span><i class="fa-solid fa-user-gear sidebar-group-icon" aria-hidden="true"></i>@Localizer["Views.Shared._SidebarNav.Systems"]</span><span class="sidebar-group-count">@visiblePermissionItems.Length</span><i class="fas fa-angle-down" aria-hidden="true"></i></button></div><div class="collapse @(administrationExpanded ? "show" : null)" id="sidebarAdministration"><button type="button" class="nav-link sidebar-nested-toggle @(!administrationExpanded ? "collapsed" : null)" data-bs-toggle="collapse" data-bs-target="#sidebarPermissions" aria-expanded="@administrationExpanded.ToString().ToLowerInvariant()" aria-controls="sidebarPermissions" data-permissions="Views.Shared._SidebarNav.Systems.Permissions" data-i18n-key="Views.Shared._SidebarNav.Systems.Permissions">@Localizer["Views.Shared._SidebarNav.Systems.Permissions"]<span class="sb-sidenav-collapse-arrow"><i class="fas fa-angle-down"></i></span></button><div class="collapse @(administrationExpanded ? "show" : null)" id="sidebarPermissions"><nav class="sb-sidenav-menu-nested nav">@foreach (var item in visiblePermissionItems) { <a class="@LinkClass(item.Item1)" aria-current="@Current(item.Item1)" asp-controller="@item.Item1" asp-action="Index" title="@Localizer[item.Item2]" data-permissions="@item.Item2" data-i18n-key="@item.Item2">@Localizer[item.Item2]</a> }</nav></div></div></section>
}
