@model ICP.Models.ForwarderDataUploadListViewModel
@using ICP.Helpers
@using ICP.Models.Forwarder
@{
    var wrapClasses = "forwarder-table-wrap";
    if (Model.TableUi.StickyHeader == true)
    {
        wrapClasses += " forwarder-sticky-enabled";
    }

    if (Model.TableUi.StickyLeftColumns == true)
    {
        wrapClasses += " forwarder-sticky-left-enabled";
    }

    var theadClasses = "table-light";
    if (Model.TableUi.StickyHeader == true)
    {
        theadClasses += " forwarder-sticky-header";
    }

    string ResolveHeaderCellClass(ForwarderTableFieldMetadata field)
    {
        if (Model.TableUi.StickyLeftColumns == true
            && string.Equals(field.FieldName, "DuplicateStatus", StringComparison.OrdinalIgnoreCase))
        {
            return "forwarder-duplicate-col";
        }

        return string.Empty;
    }
}

<div>
    <div class="upload-page-preview-toolbar">
        <label class="form-label" for="forwarderCanUploadFilter">
            @Localizer["Forwarder.ForwarderDataUpload.Column.Duplicate"]
        </label>
        <select id="forwarderCanUploadFilter"
                class="form-select form-select-sm forwarder-can-upload-filter">
            <option value="">@Localizer["Function.MassUpdate.StatusFilter.All"]</option>
            <option value="None">@Localizer["Forwarder.ForwarderDataUpload.Duplicate.None"]</option>
            <option value="DbDuplicate">@Localizer["Forwarder.ForwarderDataUpload.Duplicate.DbDuplicate"]</option>
            <option value="InFileMultiLine">@Localizer["Forwarder.ForwarderDataUpload.Duplicate.InFileMultiLine"]</option>
        </select>
    </div>
<div class="@wrapClasses">
    <table id="datatable" class="table table-striped table-sm table-bordered align-middle mb-0 forwarder-pro-table w-100">
        <thead class="@theadClasses">
            <tr>
                @foreach (var field in Model.Fields)
                {
                    var headerClass = ResolveHeaderCellClass(field);
                    <th class="@headerClass">@ForwarderTableViewHelper.ResolveHeaderLabel(field, key => Localizer[key].Value)</th>
                }
            </tr>
            @if (Model.HasFilterRow)
            {
                <tr class="users-filter-row">
                    @foreach (var field in Model.Fields)
                    {
                        var filterClass = ResolveHeaderCellClass(field);
                        var thClass = string.IsNullOrWhiteSpace(filterClass)
                            ? "sorting_disabled"
                            : $"{filterClass} sorting_disabled";
                        <th class="@thClass">
                            @if (field.Searchable
                                && !string.Equals(field.FieldName, "DuplicateStatus", StringComparison.OrdinalIgnoreCase))
                            {
                                @await Html.PartialAsync("_ProDataTablesFilter", ($"filter-{field.FieldName}", field.FieldName))
                            }
                        </th>
                    }
                </tr>
            }
        </thead>
        <tbody>
            @{
                var rowIndex = 0;
            }
            @foreach (var item in Model.ListData)
            {
                rowIndex++;
                <tr class="@ForwarderTableViewHelper.ResolveRowClass(item)">
                    @foreach (var field in Model.Fields)
                    {
                        @if (string.Equals(field.FieldName, "DuplicateStatus", StringComparison.OrdinalIgnoreCase))
                        {
                            var duplicateCellClass = Model.TableUi.StickyLeftColumns == true
                                ? "forwarder-duplicate-cell forwarder-duplicate-col"
                                : "forwarder-duplicate-cell";
                            var statusOrder = item.IsDbDuplicate
                                ? "DbDuplicate"
                                : item.IsInFileMultiLine
                                    ? "InFileMultiLine"
                                    : "None";
                            <td class="@duplicateCellClass" data-order="@statusOrder">
                                @if (item.IsDbDuplicate)
                                {
                                    <span class="forwarder-duplicate-label forwarder-duplicate-label-issue">@Localizer["Forwarder.ForwarderDataUpload.Duplicate.DbDuplicate"]</span>
                                }
                                @if (item.IsInFileMultiLine)
                                {
                                    <span class="forwarder-duplicate-label forwarder-duplicate-label-issue">@Localizer["Forwarder.ForwarderDataUpload.Duplicate.InFileMultiLine"]</span>
                                }
                                @if (!item.IsDbDuplicate && !item.IsInFileMultiLine)
                                {
                                    <span class="forwarder-duplicate-label forwarder-duplicate-label-ok">@Localizer["Forwarder.ForwarderDataUpload.Duplicate.None"]</span>
                                }
                            </td>
                        }
                        else if (string.Equals(field.FieldName, "RowNo", StringComparison.OrdinalIgnoreCase))
                        {
                            <td class="forwarder-rowno-col text-center" data-order="@rowIndex">@rowIndex</td>
                        }
                        else
                        {
                            <td>@ForwarderTableViewHelper.FormatCellValue(item, field.FieldName)</td>
                        }
                    }
                </tr>
            }
        </tbody>
    </table>
</div>
</div>
