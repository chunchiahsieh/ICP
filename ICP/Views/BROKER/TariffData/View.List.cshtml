@model ICP.Models.TariffDataSearchListViewModel
@using ICP.Helpers
@using ICP.Models.Tariff
@{
    var wrapClasses = "tariff-table-wrap";
    if (Model.TableUi.StickyHeader == true)
    {
        wrapClasses += " tariff-sticky-enabled";
    }

    if (Model.TableUi.StickyLeftColumns == true)
    {
        wrapClasses += " tariff-sticky-left-enabled";
    }

    var theadClasses = "table-light";
    if (Model.TableUi.StickyHeader == true)
    {
        theadClasses += " tariff-sticky-header";
    }

    string ResolveHeaderCellClass(TariffTableFieldMetadata field)
    {
        if (Model.TableUi.StickyLeftColumns == true
            && string.Equals(field.FieldName, "RowNo", StringComparison.OrdinalIgnoreCase))
        {
            return "tariff-rowno-col";
        }

        return string.Empty;
    }
}

<div class="@wrapClasses">
    <table id="datatable" class="table table-striped table-hover table-bordered align-middle mb-0 tariff-pro-table w-100">
        <thead class="@theadClasses">
            <tr>
                @foreach (var field in Model.Fields)
                {
                    var headerClass = ResolveHeaderCellClass(field);
                    <th class="@headerClass">@TariffTableViewHelper.ResolveHeaderLabel(field, key => Localizer[key].Value)</th>
                }
            </tr>
            @if (Model.HasFilterRow)
            {
                <tr class="users-filter-row">
                    @foreach (var field in Model.Fields)
                    {
                        var filterClass = ResolveHeaderCellClass(field);
                        var thClass = string.IsNullOrWhiteSpace(filterClass)
                            ? "sorting_disabled"
                            : $"{filterClass} sorting_disabled";
                        <th class="@thClass">
                            @if (field.Searchable)
                            {
                                @await Html.PartialAsync("_ProDataTablesFilterByType", ($"filter-{field.FieldName}", field.FieldName, TariffMetadataHelper.ResolveFilterType(field)))
                            }
                        </th>
                    }
                </tr>
            }
        </thead>
        <tbody>
            @{
                var rowIndex = 0;
            }
            @foreach (var item in Model.ListData)
            {
                rowIndex++;
                <tr>
                    @foreach (var field in Model.Fields)
                    {
                        @if (string.Equals(field.FieldName, "RowNo", StringComparison.OrdinalIgnoreCase))
                        {
                            var rowNoClass = Model.TableUi.StickyLeftColumns == true
                                ? "tariff-rowno-col text-center"
                                : "text-center";
                            <td class="@rowNoClass">@rowIndex</td>
                        }
                        else if (string.Equals(field.FieldName, "Actions", StringComparison.OrdinalIgnoreCase))
                        {
                            <td class="text-center">
                                @if (Model.CanEditLogRemarks)
                                {
                                    <button type="button"
                                            class="btn btn-sm btn-outline-primary tariff-edit-log-remarks"
                                            data-record-id="@item.Id"
                                            data-permissions="Views.Broker.TariffData.Edit"
                                            data-i18n-key="Views.Broker.TariffData.Edit"
                                            title="@Localizer["Broker.TariffData.LogRemarks.Title"]"
                                            aria-label="@Localizer["Broker.TariffData.LogRemarks.Title"]">
                                        <i class="fas fa-pencil-alt" aria-hidden="true"></i>
                                    </button>
                                }
                                <button type="button"
                                        class="btn btn-sm btn-outline-danger tariff-delete-record"
                                        data-invoice-number="@item.InvoiceNumber"
                                        data-permissions="Views.Broker.TariffData.Delete"
                                        title="@Localizer["Broker.TariffData.Delete.Record"]"
                                        aria-label="@Localizer["Broker.TariffData.Delete.Record"]">
                                    <i class="fas fa-trash-alt" aria-hidden="true"></i>
                                </button>
                            </td>
                        }
                        else if (string.Equals(field.FieldName, "DeclarationPdf", StringComparison.OrdinalIgnoreCase))
                        {
                            var hasPdf = !string.IsNullOrWhiteSpace(item.HAWB)
                                && TariffAttachmentHelper.FindDeclarationPdfPath(Model.StorageRoot, item) is not null;
                            <td class="text-center">
                                @if (hasPdf)
                                {
                                    <button type="button" class="btn btn-sm btn-outline-secondary tariff-open-folder"
                                            data-hawb="@item.HAWB" data-kind="pdf"
                                            title="@Localizer["Broker.TariffData.Attachment.OpenFolder"]">
                                        <i class="fas fa-folder-open text-warning" aria-hidden="true"></i> PDF
                                    </button>
                                }
                            </td>
                        }
                        else if (string.Equals(field.FieldName, "CostFile", StringComparison.OrdinalIgnoreCase))
                        {
                            var hasCost = !string.IsNullOrWhiteSpace(item.HAWB)
                                && TariffAttachmentHelper.FindCostFilePath(Model.StorageRoot, item) is not null;
                            <td class="text-center">
                                @if (hasCost)
                                {
                                    <button type="button" class="btn btn-sm btn-outline-secondary tariff-open-folder"
                                            data-hawb="@item.HAWB" data-kind="cost"
                                            title="@Localizer["Broker.TariffData.Attachment.OpenFolder"]">
                                        <i class="fas fa-folder-open text-warning" aria-hidden="true"></i> Cost
                                    </button>
                                }
                            </td>
                        }
                        else
                        {
                            var cellValue = TariffTableViewHelper.FormatCellValue(item, field.FieldName);
                            if (new[] { "MAWB", "HAWB", "InvoiceNumber", "LineNo" }.Contains(field.FieldName, StringComparer.OrdinalIgnoreCase))
                            {
                                <td data-order="@cellValue">@cellValue</td>
                            }
                            else
                            {
                                <td>@cellValue</td>
                            }
                        }
                    }
                </tr>
            }
        </tbody>
    </table>
</div>
