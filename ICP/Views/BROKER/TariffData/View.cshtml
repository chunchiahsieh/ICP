@using System.Text.Json
@{
    ViewData["Title"] = Localizer["Broker.TariffData.Title"];
    var maxSizeMb = ViewData["MaxSizeMb"] as int? ?? 50;
    var maxSizeHint = string.Format(Localizer["Broker.TariffData.MaxSizeHint"].Value, maxSizeMb);
    var tariffTableConfigJson = ViewData["TariffTableConfigJson"] as string ?? "{}";
    var brokerRoles = ViewData["BrokerRoles"] as IReadOnlyList<string> ?? [];
}

@section Styles {
    <link rel="stylesheet" href="~/lib/datatables/css/jquery.dataTables.min.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/lib/datatables/css/dataTables.bootstrap.min.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Uploader/uploader.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/pro-table-filters.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/tariff-data.css" asp-append-version="true" />
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            corePlugins: {
                preflight: false,
                collapse: false
            }
        };
    </script>
}

<div class="container-fluid tariff-data-page pro-datatables-page"
     data-permissions="Views.Broker.TariffData.View"
     data-i18n-key="Views.Broker.TariffData.View">
    <div class="d-flex align-items-center justify-content-between mt-3 mb-3">
        <h4 class="mb-0">@Localizer["Broker.TariffData.Title"]</h4>
    </div>
    <p class="text-muted small mb-3">@maxSizeHint</p>

    <div class="d-flex align-items-start gap-2 flex-wrap mb-3">
        <button type="button"
                class="btn btn-outline-success align-self-center"
                id="btnTariffDataDownloadExcel"
                data-permissions="Views.Broker.TariffData.Export"
                data-i18n-key="Views.Broker.TariffData.Export">
            <i class="bi bi-file-earmark-excel me-1"></i>@Localizer["Report.DownloadExcel"]
        </button>
        <button type="button" class="btn btn-outline-secondary align-self-center" id="btnTariffDataResetFilters">
            <i class="bi bi-arrow-counterclockwise me-1"></i>@Localizer["Common.ClearAllFilters"]
        </button>
        <div data-permissions="Views.Broker.TariffData.UploadCustomsData" data-i18n-key="Views.Broker.TariffData.UploadCustomsData">
            <div id="customsDataUploader"></div>
        </div>
        <a asp-action="DownloadTemplate"
           asp-controller="TariffData"
           class="btn btn-outline-secondary align-self-center"
           data-permissions="Views.Broker.TariffData.UploadCustomsData"
           data-i18n-key="Broker.TariffData.DownloadTemplate">
            @Localizer["Broker.TariffData.DownloadTemplate"]
        </a>
        <div data-permissions="Views.Broker.TariffData.UploadDeclarationPdf"
             data-i18n-key="Views.Broker.TariffData.UploadDeclarationPdf">
            <div id="declarationPdfUploader"></div>
        </div>
        <div data-permissions="Views.Broker.TariffData.UploadCost"
             data-i18n-key="Views.Broker.TariffData.UploadCost">
            <div id="costUploader"></div>
        </div>
    </div>

    <div id="DataDiv"></div>
    <form id="tariffDeleteToken" class="d-none">@Html.AntiForgeryToken()</form>
</div>

<div class="modal fade" id="tariffBrokerModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">@Localizer["Broker.TariffData.BrokerRole"]</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <label for="tariffBrokerRole" class="form-label">@Localizer["Broker.TariffData.SelectBrokerRole"]</label>
                <select id="tariffBrokerRole" class="form-select">
                    <option value="">@Localizer["Broker.TariffData.SelectBrokerRole"]</option>
                    @foreach (var role in brokerRoles)
                    {
                        <option value="@role" selected="@(brokerRoles.Count == 1 ? "selected" : null)">@role</option>
                    }
                </select>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">@Localizer["Common.Cancel"]</button>
                <button type="button" class="btn btn-primary" id="btnTariffBrokerConfirm">@Localizer["Common.Confirm"]</button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="tariffAttachmentModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title"><span id="tariffAttachmentTitle"></span> — <span id="tariffAttachmentHawb"></span></h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div id="tariffAttachmentEmpty" class="text-muted text-center py-4 d-none">
                    @Localizer["Broker.TariffData.Attachment.Empty"]
                </div>
                <div class="table-responsive">
                    <table class="table table-sm table-bordered align-middle" id="tariffAttachmentTable">
                        <thead><tr>
                            <th>@Localizer["Broker.TariffData.Attachment.FileName"]</th>
                            <th>@Localizer["Broker.TariffData.Attachment.Size"]</th>
                            <th>@Localizer["Broker.TariffData.Attachment.UploadTime"]</th>
                            <th>@Localizer["Broker.TariffData.Attachment.UploadUser"]</th>
                            <th>@Localizer["Broker.TariffData.Column.Actions"]</th>
                        </tr></thead>
                        <tbody></tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="d-none" aria-hidden="true">
    <button type="button"
            data-permissions="Views.Broker.TariffData.UploadCustomsData"
            data-i18n-key="Views.Broker.TariffData.UploadCustomsData">Upload</button>
    <button type="button"
            data-permissions="Views.Broker.TariffData.UploadDeclarationPdf"
            data-i18n-key="Views.Broker.TariffData.UploadDeclarationPdf">Upload</button>
    <button type="button"
            data-permissions="Views.Broker.TariffData.UploadCost"
            data-i18n-key="Views.Broker.TariffData.UploadCost">Upload</button>
</div>

@section Scripts {
    <script src="~/Uploader/index.js" asp-append-version="true"></script>
    <script src="~/lib/datatables/js/jquery.dataTables.min.js" asp-append-version="true"></script>
    <script src="~/lib/datatables/js/dataTables.bootstrap.min.js" asp-append-version="true"></script>
    <script src="~/js/pro-datatables.js" asp-append-version="true"></script>
    <script src="~/js/pro-table-filters.js" asp-append-version="true"></script>
    <script src="~/js/tariff-protable.js" asp-append-version="true"></script>
    <script>
        $(function () {
            var maxSizeMb = @maxSizeMb;
            var maxSizeHint = @Html.Raw(JsonSerializer.Serialize(maxSizeHint));
            var selectedBrokerRole = '';
            var uploaderButtonClass = 'btn btn-primary align-self-center d-inline-flex align-items-center gap-2';
            var tariffTableConfig = @Html.Raw(tariffTableConfigJson);
            var tariffFilterFieldMap = window.TariffProTable
                ? TariffProTable.buildTariffFilterFieldMap(tariffTableConfig.fields || [])
                : {};
            var tariffFilterHooks = window.TariffProTable
                ? TariffProTable.buildTariffFilterHooks(tariffFilterFieldMap)
                : {};

            function hasPermission(code) {
                var config = window.IcpPermissions || { superUser: false, allowedCodes: [] };
                if (config.superUser) {
                    return true;
                }

                var normalized = (code || '').toLowerCase();
                return (config.allowedCodes || []).some(function (allowed) {
                    return (allowed || '').toLowerCase() === normalized;
                });
            }

            function syncTariffStickyHeaderOffset() {
                if (!tariffTableConfig.stickyHeader) {
                    return;
                }

                $('#DataDiv .tariff-pro-table').each(function () {
                    var table = this;
                    var $titleRow = $(table).find('thead.tariff-sticky-header > tr').first();
                    if (!$titleRow.length) {
                        return;
                    }

                    var titleHeight = Math.ceil($titleRow[0].getBoundingClientRect().height);
                    table.style.setProperty('--tariff-header-row-height', titleHeight + 'px');
                });
            }

            function renumberTariffRowNo() {
                var $table = $('#DataDiv .tariff-pro-table');
                if (!$table.length || !$.fn.dataTable.isDataTable($table[0])) {
                    return;
                }

                var start = $table.DataTable().page.info().start;
                $table.find('tbody .tariff-rowno-col').each(function (index) {
                    $(this).text(start + index + 1);
                });
            }

            function applyTariffActionPermissions($container) {
                ($container || $('#DataDiv')).find('[data-permissions]').each(function () {
                    var $element = $(this);
                    $element.prop('hidden', !hasPermission($element.attr('data-permissions')));
                });
            }

            var tableInstance = null;

            if (window.ProDataTables && ProDataTables.initUsers && hasPermission('Views.Broker.TariffData.View')) {
                var sortColumn = tariffTableConfig.initialSortColumn ?? 0;
                var sortDirection = tariffTableConfig.initialSortDirection || 'desc';
                tableInstance = ProDataTables.initUsers(ProDataTables.buildConfig($.extend({
                    filterOptionsUrl: '@Url.Action("GetFilterOptions", "TariffData")',
                    queryUrl: '@Url.Action("Query", "TariffData")',
                    pageLength: 10,
                    initialSort: [[sortColumn, sortDirection]],
                    onDraw: function () {
                        syncTariffStickyHeaderOffset();
                        renumberTariffRowNo();
                        applyTariffActionPermissions($('#DataDiv'));
                    },
                    onAfterRender: function ($div) {
                        applyTariffActionPermissions($div);
                        if (window.ProTableFilters && ProTableFilters.updateAllProTableFilterCounts) {
                            ProTableFilters.updateAllProTableFilterCounts($div, tariffFilterFieldMap);
                        }
                    }
                }, tariffFilterHooks)));

                if (window.TariffProTable) {
                    TariffProTable.bindTariffFilterActions(tableInstance);
                }
            }

            function reloadTable() {
                if (tableInstance && tableInstance.reload) {
                    tableInstance.reload();
                }
            }

            $('#btnTariffDataResetFilters').on('click', function () {
                if (tableInstance && tableInstance.clearFilters) {
                    tableInstance.clearFilters();
                }
            });

            function deleteTariff(url, id, kind, confirmMessage) {
                if (!hasPermission('Views.Broker.TariffData.Delete') || !window.confirm(confirmMessage)) {
                    return;
                }

                var payload = {
                    id: id,
                    __RequestVerificationToken: $('#tariffDeleteToken input[name="__RequestVerificationToken"]').val()
                };
                if (kind) {
                    payload.kind = kind;
                }

                $.ajax({ url: url, type: 'POST', data: payload, dataType: 'json' })
                    .done(function (result) {
                        if (result && result.success) {
                            reloadTable();
                        }
                        window.alert((result && result.message) || @Html.Raw(JsonSerializer.Serialize(Localizer["Broker.TariffData.Delete.Failed"].Value)));
                    })
                    .fail(function (xhr) {
                        window.alert((xhr.responseJSON && xhr.responseJSON.message)
                            || @Html.Raw(JsonSerializer.Serialize(Localizer["Broker.TariffData.Delete.Failed"].Value)));
                    });
            }

            $('#DataDiv').on('click', '.tariff-delete-record', function () {
                var $button = $(this);
                var message = @Html.Raw(JsonSerializer.Serialize(Localizer["Broker.TariffData.Delete.RecordConfirm"].Value));
                deleteTariff('@Url.Action("DeleteRecord", "TariffData")', $button.data('record-id'), null,
                    message.replace('{0}', $button.data('hawb')));
            });

            function createTariffUploader(selector, config) {
                if (typeof window.createUploader !== 'function') {
                    return;
                }

                window.createUploader(selector, $.extend({
                    multiple: true,
                    maxSize: maxSizeMb,
                    maxSizeHint: maxSizeHint,
                    fieldName: 'file',
                    buttonClass: uploaderButtonClass,
                    onSuccess: reloadTable
                }, config));
            }

            if (hasPermission('Views.Broker.TariffData.UploadCustomsData')) {
                var brokerModalElement = document.getElementById('tariffBrokerModal');
                var brokerModal = bootstrap.Modal.getOrCreateInstance(brokerModalElement);

                function selectBrokerBeforeUpload() {
                    return new Promise(function (resolve) {
                        var settled = false;
                        function finish(result) {
                            if (settled) return;
                            settled = true;
                            $('#btnTariffBrokerConfirm').off('click.tariffBroker');
                            $(brokerModalElement).off('hidden.bs.modal.tariffBroker');
                            resolve(result);
                        }

                        $('#btnTariffBrokerConfirm').off('click.tariffBroker').on('click.tariffBroker', function () {
                            var broker = String($('#tariffBrokerRole').val() || '').trim();
                            if (!broker) {
                                window.alert(@Html.Raw(JsonSerializer.Serialize(Localizer["Broker.TariffData.SelectBrokerRole"].Value)));
                                return;
                            }
                            selectedBrokerRole = broker;
                            finish(true);
                            brokerModal.hide();
                        });
                        $(brokerModalElement).off('hidden.bs.modal.tariffBroker').on('hidden.bs.modal.tariffBroker', function () {
                            finish(false);
                        });
                        brokerModal.show();
                    });
                }

                createTariffUploader('#customsDataUploader', {
                    multiple: false,
                    title: @Html.Raw(JsonSerializer.Serialize(Localizer["Broker.TariffData.UploadCustomsDataTitle"].Value)),
                    buttonText: @Html.Raw(JsonSerializer.Serialize(Localizer["Broker.TariffData.UploadCustomsDataButton"].Value)),
                    uploadUrl: '@Url.Action("UploadCustomsData", "TariffData")',
                    fileTypes: '.xlsx,.xls',
                    beforeOpen: selectBrokerBeforeUpload,
                    extraFormData: function () { return { broker: selectedBrokerRole }; }
                });
            }

            if (hasPermission('Views.Broker.TariffData.UploadDeclarationPdf')) {
                createTariffUploader('#declarationPdfUploader', {
                    title: @Html.Raw(JsonSerializer.Serialize(Localizer["Broker.TariffData.UploadDeclarationPdfTitle"].Value)),
                    buttonText: @Html.Raw(JsonSerializer.Serialize(Localizer["Broker.TariffData.UploadDeclarationPdfButton"].Value)),
                    uploadUrl: '@Url.Action("UploadDeclarationPdf", "TariffData")',
                    fileTypes: '.pdf'
                });
            }

            if (hasPermission('Views.Broker.TariffData.UploadCost')) {
                createTariffUploader('#costUploader', {
                    title: @Html.Raw(JsonSerializer.Serialize(Localizer["Broker.TariffData.UploadCostTitle"].Value)),
                    buttonText: @Html.Raw(JsonSerializer.Serialize(Localizer["Broker.TariffData.UploadCostButton"].Value)),
                    uploadUrl: '@Url.Action("UploadCost", "TariffData")',
                    fileTypes: '.xlsx,.xls'
                });
            }

            var attachmentState = { hawb: '', kind: '' };
            var attachmentModal = bootstrap.Modal.getOrCreateInstance(document.getElementById('tariffAttachmentModal'));

            function formatFileSize(bytes) {
                if (!bytes) return '0 B';
                var units = ['B', 'KB', 'MB', 'GB'];
                var index = Math.min(Math.floor(Math.log(bytes) / Math.log(1024)), units.length - 1);
                return (bytes / Math.pow(1024, index)).toFixed(index ? 1 : 0) + ' ' + units[index];
            }

            function loadAttachments() {
                $.getJSON('@Url.Action("ListAttachments", "TariffData")', attachmentState)
                    .done(function (result) {
                        var files = result.files || [];
                        var $body = $('#tariffAttachmentTable tbody').empty();
                        files.forEach(function (file) {
                            var $row = $('<tr>');
                            var displayName = file.isCurrent ? file.originalFileName + ' (Current)' : file.originalFileName;
                            $('<td>').text(displayName).appendTo($row);
                            $('<td>').text(formatFileSize(file.fileSize)).appendTo($row);
                            $('<td>').text(new Date(file.createTime).toLocaleString()).appendTo($row);
                            $('<td>').text(file.createUser || '').appendTo($row);
                            var $actions = $('<td class="text-nowrap">');
                            $('<a class="btn btn-sm btn-outline-primary me-1">')
                                .attr('href', '@Url.Action("DownloadAttachment", "TariffData")?hawb=' + encodeURIComponent(attachmentState.hawb) + '&kind=' + encodeURIComponent(attachmentState.kind) + '&fileName=' + encodeURIComponent(file.originalFileName))
                                .text(@Html.Raw(JsonSerializer.Serialize(Localizer["Broker.TariffData.Attachment.Download"].Value)))
                                .appendTo($actions);
                            if (hasPermission('Views.Broker.TariffData.Delete')) {
                                $('<button type="button" class="btn btn-sm btn-outline-danger tariff-modal-delete">')
                                    .attr('data-file-name', file.originalFileName)
                                    .text(@Html.Raw(JsonSerializer.Serialize(Localizer["Broker.TariffData.Delete.Record"].Value)))
                                    .appendTo($actions);
                            }
                            $actions.appendTo($row);
                            $body.append($row);
                        });
                        $('#tariffAttachmentEmpty').toggleClass('d-none', files.length !== 0);
                        $('#tariffAttachmentTable').toggleClass('d-none', files.length === 0);
                    })
                    .fail(function (xhr) { window.alert(xhr.responseJSON?.message || @Html.Raw(JsonSerializer.Serialize(Localizer["Broker.TariffData.Delete.Failed"].Value))); });
            }

            $('#DataDiv').on('click', '.tariff-open-folder', function () {
                attachmentState.hawb = String($(this).data('hawb') || '');
                attachmentState.kind = String($(this).data('kind') || '');
                $('#tariffAttachmentHawb').text(attachmentState.hawb);
                $('#tariffAttachmentTitle').text(attachmentState.kind === 'pdf' ? 'PDF' : 'Cost');
                loadAttachments();
                attachmentModal.show();
            });

            $('#tariffAttachmentTable').on('click', '.tariff-modal-delete', function () {
                if (!window.confirm(@Html.Raw(JsonSerializer.Serialize(Localizer["Broker.TariffData.Attachment.DeleteConfirm"].Value)))) return;
                $.post('@Url.Action("DeleteAttachment", "TariffData")', {
                    hawb: attachmentState.hawb,
                    kind: attachmentState.kind,
                    fileName: $(this).data('file-name'),
                    __RequestVerificationToken: $('#tariffDeleteToken input[name="__RequestVerificationToken"]').val()
                }).done(function (result) { window.alert(result.message); loadAttachments(); reloadTable(); })
                  .fail(function (xhr) { window.alert(xhr.responseJSON?.message || @Html.Raw(JsonSerializer.Serialize(Localizer["Broker.TariffData.Delete.Failed"].Value))); });
            });

            $('#btnTariffDataDownloadExcel').on('click', function () {
                if (!window.TariffProTable || !TariffProTable.downloadExcel) {
                    return;
                }

                TariffProTable.downloadExcel({
                    downloadUrl: '@Url.Action("DownloadExcel", "TariffData")',
                    filterFieldMap: tariffFilterFieldMap,
                    confirmAllMessage: @Html.Raw(JsonSerializer.Serialize(Localizer["Broker.TariffData.ExportAllConfirm"].Value))
                });
            });
        });
    </script>
}
