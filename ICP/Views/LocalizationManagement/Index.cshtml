@using System.Text.Json
@{
    ViewData["Title"] = Localizer["LocalizationManagement.Title"];
}

<div class="mt-3 localization-management">
    <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-2">
        <h4 class="mb-0">@Localizer["LocalizationManagement.Title"]</h4>
        <div class="d-flex flex-wrap gap-2">
            <a class="btn btn-outline-secondary btn-sm" href="@Url.Action("Export", "LocalizationManagement")">@Localizer["LocalizationManagement.ExportExcel"]</a>
            <button type="button" class="btn btn-outline-primary btn-sm" id="importLocalizationExcel">@Localizer["LocalizationManagement.ImportExcel"]</button>
            <button type="button" class="btn btn-primary btn-sm" id="saveLocalizationChanges" disabled>@Localizer["LocalizationManagement.SaveChanges"]</button>
        </div>
    </div>
    <p class="text-muted mb-3">@Localizer["LocalizationManagement.Hint"]</p>
    <div id="localizationMessage" class="alert d-none py-2" role="alert"></div>
    <input id="localizationImportFile" type="file" accept=".xlsx,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet" hidden />
    <div class="mb-3">
        <input type="search" id="localizationSearch" class="form-control" autocomplete="off"
               placeholder="@Localizer["LocalizationManagement.Search"]" />
    </div>
    <div class="table-responsive localization-management-table-wrapper">
        <table class="table table-sm table-bordered align-middle mb-0" id="localizationTable">
            <thead>
                <tr>
                    <th>Resource Key</th>
                    <th>預設</th>
                    <th>繁體中文</th>
                    <th>English</th>
                    <th>日本語</th>
                </tr>
            </thead>
            <tbody></tbody>
        </table>
    </div>
</div>

@section Styles {
    <style>
        .localization-management-table-wrapper { max-height: calc(100vh - 260px); }
        .localization-management-table-wrapper thead th { background: #f8f9fa; position: sticky; top: 0; z-index: 1; white-space: nowrap; }
        .localization-management-table-wrapper table { min-width: 1200px; }
        .localization-management-table-wrapper th:first-child { min-width: 280px; }
        .localization-management-table-wrapper td { min-width: 300px; }
        .localization-management-table-wrapper .form-control.is-modified { background-color: #fff8d9; }
    </style>
}

@section Scripts {
    <script>
        $(function () {
            var rows = [];
            var originalRows = new Map();
            var $tbody = $('#localizationTable tbody');
            var $saveButton = $('#saveLocalizationChanges');
            var $message = $('#localizationMessage');
            var labels = {
                loading: @Html.Raw(JsonSerializer.Serialize(Localizer["LocalizationManagement.Loading"].Value)),
                noRows: @Html.Raw(JsonSerializer.Serialize(Localizer["LocalizationManagement.NoRows"].Value)),
                loadFailed: @Html.Raw(JsonSerializer.Serialize(Localizer["LocalizationManagement.LoadFailed"].Value)),
                saveFailed: @Html.Raw(JsonSerializer.Serialize(Localizer["LocalizationManagement.SaveFailed"].Value)),
                saved: @Html.Raw(JsonSerializer.Serialize(Localizer["LocalizationManagement.Saved"].Value)),
                noChanges: @Html.Raw(JsonSerializer.Serialize(Localizer["LocalizationManagement.NoChanges"].Value)),
                importFailed: @Html.Raw(JsonSerializer.Serialize(Localizer["LocalizationManagement.ImportFailed"].Value)),
                imported: @Html.Raw(JsonSerializer.Serialize(Localizer["LocalizationManagement.Imported"].Value))
            };

            function escapeHtml(value) {
                return $('<div>').text(value || '').html();
            }

            function showMessage(type, text) {
                $message.removeClass('d-none alert-success alert-danger alert-info')
                    .addClass('alert-' + type)
                    .text(text);
            }

            function changedRows() {
                return rows.filter(function (row) {
                    var original = originalRows.get(row.key);
                    return original && (row.default !== original.default || row.zhTw !== original.zhTw || row.en !== original.en || row.ja !== original.ja);
                });
            }

            function updateSaveButton() {
                $saveButton.prop('disabled', changedRows().length === 0);
            }

            function render() {
                var search = ($('#localizationSearch').val() || '').toLowerCase();
                var visibleRows = rows.filter(function (row) {
                    return !search || [row.key, row.default, row.zhTw, row.en, row.ja].join(' ').toLowerCase().indexOf(search) >= 0;
                });

                if (visibleRows.length === 0) {
                    $tbody.html('<tr><td colspan="5" class="text-center text-muted">' + escapeHtml(labels.noRows) + '</td></tr>');
                    return;
                }

                $tbody.empty();
                visibleRows.forEach(function (row) {
                    var $tr = $('<tr>').attr('data-key', row.key);
                    $tr.append($('<td>').addClass('font-monospace text-break').text(row.key));
                    ['default', 'zhTw', 'en', 'ja'].forEach(function (field) {
                        var $input = $('<input>', { type: 'text', class: 'form-control form-control-sm', value: row[field] || '' })
                            .attr('data-field', field)
                            .attr('aria-label', row.key + ' ' + field);
                        var original = originalRows.get(row.key);
                        $input.toggleClass('is-modified', original && row[field] !== original[field]);
                        $tr.append($('<td>').append($input));
                    });
                    $tbody.append($tr);
                });
            }

            $tbody.on('input', 'input[data-field]', function () {
                var $input = $(this);
                var key = $input.closest('tr').data('key');
                var row = rows.find(function (item) { return item.key === key; });
                if (!row) return;
                var field = $input.data('field');
                row[field] = $input.val();
                var original = originalRows.get(key);
                $input.toggleClass('is-modified', row[field] !== original[field]);
                updateSaveButton();
            });

            $('#localizationSearch').on('input', render);

            $saveButton.on('click', function () {
                var changes = changedRows();
                if (changes.length === 0) {
                    showMessage('info', labels.noChanges);
                    return;
                }

                $saveButton.prop('disabled', true);
                $.ajax({
                    url: '@Url.Action("Save", "LocalizationManagement")',
                    method: 'POST',
                    contentType: 'application/json',
                    data: JSON.stringify({ rows: changes })
                }).done(function (result) {
                    changes.forEach(function (row) {
                        originalRows.set(row.key, $.extend({}, row));
                    });
                    render();
                    showMessage('success', labels.saved.replace('{0}', result.changedCount));
                }).fail(function (xhr) {
                    showMessage('danger', xhr.responseJSON && xhr.responseJSON.message ? xhr.responseJSON.message : labels.saveFailed);
                }).always(updateSaveButton);
            });

            function loadRows() {
                $tbody.html('<tr><td colspan="5" class="text-center text-muted">' + escapeHtml(labels.loading) + '</td></tr>');
                $.getJSON('@Url.Action("Rows", "LocalizationManagement")')
                    .done(function (result) {
                        rows = result || [];
                        originalRows = new Map();
                        rows.forEach(function (row) { originalRows.set(row.key, $.extend({}, row)); });
                        render();
                        updateSaveButton();
                    })
                    .fail(function () {
                        $tbody.html('<tr><td colspan="5" class="text-center text-danger">' + escapeHtml(labels.loadFailed) + '</td></tr>');
                    });
            }

            $('#importLocalizationExcel').on('click', function () { $('#localizationImportFile').trigger('click'); });
            $('#localizationImportFile').on('change', function () {
                var file = this.files && this.files[0];
                if (!file) return;
                var formData = new FormData(); formData.append('file', file);
                $.ajax({ url: '@Url.Action("Import", "LocalizationManagement")', method: 'POST', data: formData, processData: false, contentType: false })
                    .done(function (result) { showMessage('success', labels.imported.replace('{0}', result.importedCount).replace('{1}', result.changedCount)); loadRows(); })
                    .fail(function (xhr) { showMessage('danger', xhr.responseJSON && xhr.responseJSON.message ? xhr.responseJSON.message : labels.importFailed); })
                    .always(function () { $('#localizationImportFile').val(''); });
            });

            loadRows();
        });
    </script>
}
