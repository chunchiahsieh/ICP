@model ICP.Models.RoleMailGroupsSearchListViewModel
@{
    var filterColumns = new[]
    {
        ("filter-MailGroupName", "MailGroupName"),
        ("filter-MailGroupAddress", "MailGroupAddress"),
        ("filter-RoleCode", "RoleCode"),
        ("filter-RoleName", "RoleName"),
        ("filter-CreateTime", "CreateTime"),
        ("filter-CreateUser", "CreateUser")
    };
}

<table id="datatable" class="table table-striped">
    <thead>
        <tr>
            <th class="sorting_disabled">
                <input type="checkbox" class="list-select-all" title="@Localizer["Common.SelectAllPage"]" />
            </th>
            <th>@Localizer["RoleMailGroups.Col.RoleCode"]</th>
            <th>@Localizer["RoleMailGroups.Col.RoleName"]</th>
            <th>@Localizer["RoleMailGroups.Col.Name"]</th>
            <th>@Localizer["RoleMailGroups.Col.Address"]</th>
            <th>@Localizer["RoleMailGroups.Col.CreateTime"]</th>
            <th>@Localizer["RoleMailGroups.Col.CreateUser"]</th>
        </tr>
        <tr class="users-filter-row">
            <th class="sorting_disabled"></th>
            @foreach (var (filterId, column) in filterColumns)
            {
                <th class="sorting_disabled">
                    @await Html.PartialAsync("_ProDataTablesFilter", (filterId, column))
                </th>
            }
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model.ListData)
        {
            <tr data-id="@item.Id">
                <td><input type="checkbox" class="row-list-cb" data-id="@item.Id" /></td>
                <td>@item.RoleCode</td>
                <td>@item.RoleName</td>
                <td>@item.MailGroupName</td>
                <td>@item.MailGroupAddress</td>
                <td>@item.CreateTime.ToString("yyyy-MM-dd HH:mm:ss")</td>
                <td>@item.CreateUser</td>
            </tr>
        }
    </tbody>
</table>
