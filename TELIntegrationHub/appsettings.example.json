{
  "_comment_AppSettingsSelection": "AGA-PC: appsettings.json (+ appsettings.Development.json in Development). Non-AGA: only appsettings.TEL.json (see Program.cs).",
  "ConnectionStrings": {
    "HubDatabase": "Server=YOUR_SERVER;Database=TEL_IntegrationHub;User Id=YOUR_USER;Password=YOUR_PASSWORD;TrustServerCertificate=True",
    "ICP_Connection": "Server=YOUR_SERVER;Database=TEL-ICP;User Id=YOUR_USER;Password=YOUR_PASSWORD;TrustServerCertificate=True;MultipleActiveResultSets=True",
    "ICPFileGenerator": "Server=YOUR_SERVER;Database=TEL-ICPFileGenerator;User Id=YOUR_USER;Password=YOUR_PASSWORD;TrustServerCertificate=True;MultipleActiveResultSets=True"
  },
  "Integration": {
    "RabbitMq": {
      "_comment_ManagementUi": "Management UI: http://localhost:15672/ (AMQP Port is 5672)",
      "Enabled": true,
      "HostName": "localhost",
      "Port": 5672,
      "VirtualHost": "/",
      "UserName": "mq_admin",
      "Password": "mq_admin",
      "Exchange": "tel.integration",
      "ExchangeType": "topic",
      "RoutingKey": "icp.shipinfo.case.initiated",
      "RoutingKeys": [
        "icp.shipinfo.case.initiated",
        "icp.export.completed"
      ],
      "QueueName": "tel.integration.hub.queue"
    },
    "Database": {
      "EnsureCreatedOnStartup": true
    }
  },
  "Swagger": {
    "Enabled": true
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning"
      }
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
